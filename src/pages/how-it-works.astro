---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE } from "../config";

const steps = [
  {
    t: "Protect",
    id: "step-protect",
    sum: "Open Kirpik in your Shopify admin, select your products, blog articles and pages, and click Protect. Kirpik embeds an invisible watermark carrying your store's unique code into each one.",
  },
  {
    t: "Prove Infringement",
    id: "step-prove",
    sum: "Paste suspect text to confirm it's yours. Enter the URL of the site hosting the infringing content to issue a Proof of Ownership Certificate.",
  },
  {
    t: "Enforce",
    id: "step-enforce",
    sum: "Use the Proof of Ownership Certificate to enforce your rights and issue DMCA takedown requests to platforms, search engines, hosts and registrars.",
  },
];

const howToJsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to watermark your Shopify text content and prove ownership of stolen content",
  description:
    "Watermark Shopify product descriptions, blog articles and pages invisibly, detect the watermark in copied text anywhere, and generate a Proof of Ownership Certificate to support a DMCA takedown.",
  step: steps.map((s, i) => ({
    "@type": "HowToStep",
    position: i + 1,
    name: s.t,
    text: s.sum,
    url: `${SITE.url}/how-it-works/#${s.id}`,
  })),
};
---

<Base
  title="How it works"
  description="How Kirpik protects Shopify text in three steps: embed an invisible watermark in your descriptions, articles and pages, detect it in copied text anywhere, and generate a Proof of Ownership Certificate for the takedown."
  jsonLd={howToJsonLd}
>
  <PageHero
    title="Protect, prove, enforce: how Kirpik works."
    lead="Kirpik protects the text you already wrote, detects it on any site you check, and turns the match into evidence a host can act on."
  />

  <!-- ======================= Protect ======================= -->
  <section class="section" id="step-protect" style="padding-top:1rem">
    <div class="container step">
      <div class="step__body" data-reveal>
        <h2>Protect your text</h2>
        <p class="lead">{steps[0].sum}</p>
        <ul class="step__list">
          <li>
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Covers product descriptions, blog articles and pages
          </li>
          <li>
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            One click per item, in batches, or automatically on Pro
          </li>
          <li>
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Reversible: restore any item at any time
          </li>
        </ul>
      </div>
      <div class="step__art" data-reveal>
        <div class="mock card" aria-hidden="true">
          <div class="mock__row"><span class="mock__name">Copper Pour-Over Carafe</span><span class="tag tag--mint">✓ Protected</span></div>
          <div class="mock__row"><span class="mock__name">Juniper &amp; Cedar Soy Candle</span><span class="tag tag--mint">✓ Protected</span></div>
          <div class="mock__row"><span class="mock__name">Washed Linen Apron</span><span class="tag tag--mint">✓ Protected</span></div>
          <div class="mock__row"><span class="mock__name">Walnut Serving Board</span><span class="tag">Queued</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= Detect ======================= -->
  <section class="section section--tone" id="step-prove">
    <div class="container step step--flip">
      <div class="step__body" data-reveal>
        <h2>Prove Infringement</h2>
        <p class="lead">{steps[1].sum}</p>
        <ul class="step__list">
          <li>
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Paste detection on every plan, including Free
          </li>
          <li>
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            URL checks included on every plan, with a monthly allowance
          </li>
          <li>
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Trimmed, edited or reformatted versions still match
          </li>
        </ul>
      </div>
      <div class="step__art" data-reveal>
        <div class="hud mock__detect" aria-hidden="true">
          <span>&gt; detect · url</span><br />
          <span>&gt; fetching bargainreef-example.shop/products/copper-carafe</span><br />
          <span class="ok">✓ watermark detected</span><br />
          <span>owner &nbsp;&nbsp;&nbsp;&nbsp;<b>your-store.myshopify.com</b></span><br />
          <span>confidence <b>100.0%</b></span><br />
          <span>→ generate certificate</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= Enforce ======================= -->
  <section class="section" id="step-enforce">
    <div class="container step">
      <div class="step__body" data-reveal>
        <h2>Enforce your rights</h2>
        <p class="lead">
          eCommerce Platforms, Search Engines, Hosting Providers and Domain
          Registrars have a legal obligation to respect Intellectual Property
          laws: Use Kirpik's Proof of Ownership Certificates to enforce your
          rights and issue DMCA takedown requests.
        </p>
        <ul class="step__list">
          <li>
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Fingerprints of your original and of the stolen text
          </li>
          <li>
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Your protection date versus the stolen page's timestamps and the Wayback Machine
          </li>
          <li>
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Side-by-side comparison of the original and the stolen version
          </li>
          <li>
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            QR code to a verification page anyone can check
          </li>
          <li>
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Check our <a href="/enforcement/">Enforcement Guide</a> for more information
          </li>
        </ul>
      </div>
      <div class="step__art" data-reveal>
        <img
          class="step__cert"
          src="/img/chain-of-proof-top.png"
          alt="A Kirpik Proof of Ownership Certificate"
          width="620"
          height="404"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ======================= Performance ======================= -->
  <section class="section section--ink">
    <div class="container perf__grid">
      <div>
        <h2>Your content is protected; your site's performance is untouched.</h2>
        <p class="lead" style="margin-top:1rem">
          Kirpik's watermark is applied once - without modifying your content.
          It doesn't load any scripts, slow down your site or negatively
          affect your site's SEO performance.
        </p>
      </div>
      <ul class="perf__list" aria-label="What stays unchanged">
        <li>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          No changes to your text
        </li>
        <li>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          No scripts loaded
        </li>
        <li>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          No SEO impact
        </li>
        <li>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          No speed impact
        </li>
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .step { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .step--flip .step__art { order: -1; }
  .step h2 { margin-bottom: 1rem; }
  .step__more { margin-top: 1.4rem; color: var(--ink-soft); }
  .step__more a { color: var(--orange-deep); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .step__list { margin-top: 1.4rem; display: grid; gap: 0.6rem; }
  .step__list li { display: flex; gap: 0.6rem; color: var(--ink); }
  .step__list li a { color: var(--orange-deep); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .step__list svg { color: var(--mint); flex: none; align-self: flex-start; margin-top: 0.32em; }

  .mock { padding: 1.3rem; }
  .mock__row { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.7rem 0; border-top: 1px solid var(--line); }
  .mock__row:first-child { border-top: 0; padding-top: 0; }
  .mock__row .tag { white-space: nowrap; }
  .mock__name { font-size: 0.95rem; font-weight: 600; color: var(--ink); }
  .mock__detect { padding: 1.4rem 1.5rem; font-size: 0.85rem; box-shadow: var(--shadow-pop); }

  .step__cert { border-radius: var(--r-md); border: 1px solid var(--line); box-shadow: var(--shadow-pop); max-width: 460px; margin-inline: auto; }

  .perf__grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .perf__list { display: grid; gap: 0.9rem; }
  .perf__list li {
    display: flex; align-items: center; gap: 0.7em;
    font-size: 1.05rem; font-weight: 600; color: var(--sand);
    border-bottom: 1px solid rgba(233,229,220,0.12);
    padding-bottom: 0.9rem;
  }
  .perf__list li:last-child { border-bottom: 0; padding-bottom: 0; }
  .perf__list svg { color: var(--mint); flex: none; }

  @media (max-width: 880px) {
    .step { grid-template-columns: 1fr; }
    .step--flip .step__art { order: 0; }
    .perf__grid { grid-template-columns: 1fr; }
  }
</style>
