---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE, CTA_LABEL } from "../config";

const shop = SITE.shopifyAppUrl;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Kirpik Store Text Check",
  applicationCategory: "SecurityApplication",
  operatingSystem: "Web",
  url: `${SITE.url}/site-check/`,
  description:
    "See exactly what a scraper can read from your Shopify store: every product description, as raw data, from the public products.json feed. Checks whether your copy carries a Kirpik watermark. Runs entirely in your browser.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Base
  title="What can a scraper read from your store?"
  description="Enter your Shopify store and see every product description a scraper can pull from it right now, exactly as raw data. Then see whether your copy carries a Kirpik watermark. Runs entirely in your browser."
  jsonLd={jsonLd}
>
  <!-- ============================ HERO / INPUT ======================= -->
  <section class="sc-hero">
    <div class="container narrow sc-hero__inner">
      <span class="eyebrow">Live text check</span>
      <h1 class="sc-hero__title">What can a scraper read from your store <em>right now</em>?</h1>
      <p class="lead sc-hero__lead">
        Enter your Shopify URL. In a few seconds you will see every product
        description on your store exactly the way a scraper sees it, as raw,
        copyable data. Then you will see whether any of it could be traced back
        to you after it is stolen.
      </p>

      <form class="sc-form" id="sc-form" role="search">
        <label class="sc-form__field">
          <span class="sr-only">Your Shopify store URL</span>
          <span class="sc-form__lock" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><rect x="4" y="10" width="16" height="10" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="2"/></svg>
          </span>
          <input
            type="text"
            id="sc-url"
            name="url"
            inputmode="url"
            autocomplete="url"
            spellcheck="false"
            placeholder="yourstore.com"
            aria-label="Your Shopify store URL"
            required
          />
        </label>
        <button class="btn btn--primary sc-form__btn" type="submit" id="sc-submit">
          <span class="sc-form__btn-label">Check my store</span>
        </button>
      </form>
      <p class="sc-hero__note">
        Runs entirely in your browser · We never see your store or its data · No login
      </p>
    </div>
  </section>

  <!-- ============================ RESULTS ============================ -->
  <section class="sc-results container" id="sc-results" hidden aria-live="polite"></section>

  <!-- ======================= PASTE ANY TEXT ========================== -->
  <section class="section" id="paste-check">
    <div class="container narrow">
      <span class="eyebrow">Check any text</span>
      <h2 class="sc-paste__title">Paste text, get an answer.</h2>
      <p class="lead">
        Found copy somewhere that reads suspiciously familiar? Paste it here.
        Kirpik's detector runs in your browser and reports whether the text
        carries a Kirpik watermark.
      </p>
      <div class="sc-paste card">
        <textarea
          id="sc-paste-input"
          rows="6"
          placeholder="Paste at least a paragraph of text to check it for a Kirpik watermark…"
          aria-label="Text to check for a Kirpik watermark"
        ></textarea>
        <div class="sc-paste__bar">
          <button class="btn btn--primary" type="button" id="sc-paste-btn">Check for watermark</button>
          <span class="sc-paste__hint">Tip: use the Copy text button on any product above, then paste it here. The watermark travels with the copy.</span>
        </div>
        <div class="sc-paste__result" id="sc-paste-result" aria-live="polite"></div>
      </div>
    </div>
  </section>

  <!-- ====================== HOW DOES THIS WORK? ===================== -->
  <section class="section section--tone" id="how" hidden>
    <div class="container narrow">
      <span class="eyebrow">How does this work?</span>
      <h2 class="sc-how__title">No tricks. We asked your store, and it answered.</h2>
      <div class="sc-how prose">
        <p>
          Everything above happened inside <strong>your own browser</strong>. Shopify publishes
          every store's catalogue through machine-readable feeds so that search engines, shopping
          channels and integrations can read products without visiting the storefront. Those
          feeds are <strong>public by design</strong>, and they carry your full product
          descriptions in a field called <code>body_html</code>:
        </p>
        <ul>
          <li><code>/products.json</code> holds every product, description, price and image URL as raw data, 250 products per request.</li>
          <li><code>/collections/all/products.json</code> serves the same catalogue, collection by collection.</li>
          <li><code>/sitemap.xml</code> maps every product, page and blog article on the store.</li>
          <li>Each blog also publishes a full-text feed at <code>/blogs/&lt;name&gt;.atom</code>.</li>
        </ul>
        <p>
          Apps that "block copying" run a script on the storefront page. These feeds are not the
          storefront page. The script never loads, the data comes straight from Shopify, and the
          text arrives ready to paste. That is why the check above works regardless of what is
          installed on the store.
        </p>
        <p class="sc-how__try">Open your store's raw feeds yourself:</p>
        <div class="sc-how__links" id="sc-feed-links">
          <span class="sc-how__hint">Run a check above and your store's direct feed links appear here.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================= THE HOOK ========================= -->
  <section class="section section--ink sc-hook">
    <div class="container narrow">
      <span class="eyebrow">What this means</span>
      <h2 class="sc-hook__title">Your words will travel. The only question is whether proof travels with them.</h2>
      <p class="lead sc-hook__lead">
        No app can close these feeds, and honestly, you would not want to: they are how search
        engines and sales channels see your store. The copy is going to be readable, and some of
        it is going to be taken. What you control is whether a stolen copy can be tied back to
        you afterwards.
      </p>

      <div class="sc-hook__split">
        <div class="sc-hook__col sc-hook__col--bad">
          <h3>Copy without a watermark</h3>
          <ul>
            <li>Reads perfectly. Pastes perfectly. Proves nothing.</li>
            <li>Once it is on someone else's page, it is your word against theirs.</li>
            <li>Hosts and marketplaces will not act on "mine looks older".</li>
            <li>Search engines may pick the thief's page as the original.</li>
          </ul>
        </div>
        <div class="sc-hook__col sc-hook__col--good">
          <h3>Copy with a Kirpik watermark</h3>
          <p>
            Kirpik embeds an invisible watermark in the text itself, derived from your original
            content and carrying your store's unique watermark code. However the copy leaves,
            <strong>scraped from a feed, pasted from the page, exported and re-imported</strong>,
            the watermark rides along.
          </p>
          <p>
            When you find it, Kirpik generates a <strong>Chain of Proof</strong> certificate:
            dated, fingerprinted and publicly verifiable. That is what turns an argument into a
            takedown.
          </p>
          <p class="sc-hook__punch">You saw the detector work above. That is the whole pitch.</p>
        </div>
      </div>

      <div class="sc-hook__cta">
        <a class="btn btn--primary" href={shop} rel="noopener" target="_blank">{CTA_LABEL} for free</a>
        <a class="btn btn--light" href="/how-it-works/">See how Kirpik works →</a>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Make every copy carry proof."
    sub="Kirpik watermarks your descriptions, articles and pages without changing a word, and turns detections into certificates. Free to start."
  />
</Base>

<script>
  import { zipSync } from "fflate";

  type ShopifyImage = { id?: number; src: string; alt?: string | null };
  type ShopifyProduct = {
    id: number;
    title: string;
    handle: string;
    body_html?: string;
    images?: ShopifyImage[];
    image?: ShopifyImage | null;
  };

  const form = document.getElementById("sc-form") as HTMLFormElement | null;
  const input = document.getElementById("sc-url") as HTMLInputElement | null;
  const submit = document.getElementById("sc-submit") as HTMLButtonElement | null;
  const btnLabel = submit?.querySelector(".sc-form__btn-label") as HTMLElement | null;
  const results = document.getElementById("sc-results") as HTMLElement | null;
  const feedLinks = document.getElementById("sc-feed-links") as HTMLElement | null;
  const howBlock = document.getElementById("how") as HTMLElement | null;

  const el = (tag: string, cls?: string, text?: string) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  };

  // --- Detection (runs locally; returns a verdict for a block of text) ----
  const q0 = [0x2008, 0x2004, 0x2005, 0x2009];
  const q1: Record<number, number> = {};
  q0.forEach((c, i) => (q1[c] = i));
  const q2: number[] = new Array(256);
  for (let i = 0; i < 256; i++) {
    let c = i;
    for (let j = 0; j < 8; j++) c = c & 0x80 ? ((c << 1) ^ 0x07) & 0xff : (c << 1) & 0xff;
    q2[i] = c;
  }
  function q3(bits: number[]): number {
    const bytes: number[] = [];
    for (let i = 0; i < bits.length; i += 8) {
      let b = 0;
      for (let j = 0; j < 8; j++) b = (b << 1) | (bits[i + j] || 0);
      bytes.push(b);
    }
    let c = 0;
    for (const b of bytes) c = q2[(c ^ b) & 0xff];
    return c;
  }
  function q4(bits: number[]): number {
    let v = 0;
    for (const b of bits) v = (v << 1) | b;
    return v;
  }
  type Verdict = { found: boolean; code?: string; markers: number; total: number; conf: number };
  function kdetect(text: string): Verdict {
    const bits: number[] = [];
    for (const ch of text) {
      const v = q1[ch.codePointAt(0) as number];
      if (v !== undefined) bits.push(v >> 1, v & 1);
    }
    if (bits.length < 28) return { found: false, markers: 0, total: 0, conf: 0 };
    let best: { n: number; w: number; code: number; total: number } | null = null;
    for (let off = 0; off < 28; off++) {
      if (bits.length - off < 28) break;
      const total = Math.floor((bits.length - off) / 28);
      const votes = new Map<number, number>();
      let n = 0;
      for (let i = 0; i < total; i++) {
        const s = off + i * 28;
        const chunk = bits.slice(s, s + 28);
        const data = chunk.slice(0, 20);
        const sum = q4(chunk.slice(20, 28));
        const code = q4(chunk.slice(4, 20));
        if (q3(data) !== sum || code === 0) continue;
        n++;
        votes.set(code, (votes.get(code) || 0) + 1);
      }
      let w = 0, code = 0;
      for (const [k, v] of votes) if (v > w) { w = v; code = k; }
      if (!best || n > best.n || (n === best.n && w > best.w)) best = { n, w, code, total };
    }
    if (!best || best.n < 2 || best.w < 2) {
      return { found: false, markers: best?.n ?? 0, total: best?.total ?? 0, conf: 0 };
    }
    return {
      found: true,
      code: "#" + best.code.toString(36).toUpperCase(),
      markers: best.n,
      total: best.total,
      conf: Math.round((best.w / best.total) * 1000) / 10,
    };
  }

  // --- Text helpers --------------------------------------------------------
  // Raw text extraction preserves the text exactly as served (so a copied
  // description behaves the same as one copied from the live page).
  function rawText(html: string): string {
    const doc = new DOMParser().parseFromString(html || "", "text/html");
    return (doc.body.textContent || "").trim();
  }
  function displayText(html: string): string {
    return rawText(html).replace(/\s+/g, " ").trim();
  }
  function wordCount(s: string): number {
    return s ? s.split(/\s+/).filter(Boolean).length : 0;
  }
  function truncate(s: string, n: number): string {
    return s.length > n ? s.slice(0, n).trimEnd() + "…" : s;
  }
  function fileNameFromSrc(src: string): string {
    try {
      const path = new URL(src).pathname;
      return decodeURIComponent(path.substring(path.lastIndexOf("/") + 1) || "image");
    } catch {
      return "image";
    }
  }
  function allImages(products: ShopifyProduct[]): { src: string; name: string }[] {
    const seen = new Set<string>();
    const out: { src: string; name: string }[] = [];
    for (const p of products) {
      for (const img of p.images || []) {
        const clean = img.src.split("?")[0];
        if (seen.has(clean)) continue;
        seen.add(clean);
        out.push({ src: img.src, name: fileNameFromSrc(img.src) });
      }
    }
    return out;
  }

  // --- Domain handling ------------------------------------------------------
  function normalizeDomain(raw: string): string | null {
    let v = (raw || "").trim().toLowerCase();
    if (!v) return null;
    v = v.replace(/^https?:\/\//, "").replace(/^www\./, "");
    v = v.split("/")[0].split("?")[0].split("#")[0].trim();
    if (!v || !v.includes(".") || /\s/.test(v)) return null;
    if (!/^[a-z0-9.-]+\.[a-z]{2,}$/.test(v)) return null;
    return v;
  }

  // --- Fetching ---------------------------------------------------------------
  const MAX_PAGES = 8; // 8 x 250 = up to 2000 products scanned
  const SHOW_LIMIT = 48;

  async function fetchCatalogue(domain: string): Promise<ShopifyProduct[]> {
    const products: ShopifyProduct[] = [];
    for (let page = 1; page <= MAX_PAGES; page++) {
      const url = `https://${domain}/products.json?limit=250&page=${page}`;
      const res = await fetch(url, { headers: { Accept: "application/json" } });
      if (!res.ok) {
        if (page === 1) throw new Error(`HTTP ${res.status}`);
        break;
      }
      const ct = res.headers.get("content-type") || "";
      if (!ct.includes("json")) {
        if (page === 1) throw new Error("not-json");
        break;
      }
      const data = await res.json();
      const batch: ShopifyProduct[] = data.products || [];
      products.push(...batch);
      if (batch.length < 250) break;
    }
    return products;
  }

  // --- Rendering ---------------------------------------------------------------
  function setBusy(busy: boolean) {
    if (!submit || !btnLabel) return;
    submit.disabled = busy;
    btnLabel.textContent = busy ? "Checking…" : "Check my store";
  }

  function renderMessage(kind: "notshopify" | "empty" | "error", domain: string) {
    if (!results) return;
    results.innerHTML = "";
    results.hidden = false;
    const card = el("div", "sc-msg");
    const copy: Record<string, [string, string]> = {
      notshopify: [
        "This isn't a standard Shopify storefront",
        `We couldn't read a public products feed at ${domain}. It may not be on Shopify, or it may be a headless or custom setup. Standard Shopify stores expose this feed automatically. If you have one, try your ".myshopify.com" address.`,
      ],
      empty: [
        "Shopify detected, but no public products found",
        `${domain} is on Shopify, but its products feed is currently empty. New or password-protected stores can look like this.`,
      ],
      error: [
        "Something went wrong reading that store",
        `We couldn't complete the check for ${domain}. Double-check the address and try again.`,
      ],
    };
    const [title, body] = copy[kind];
    card.append(el("h2", "sc-msg__title", title), el("p", "sc-msg__body", body));
    results.append(card);
  }

  type Scanned = { p: ShopifyProduct; text: string; words: number; verdict: Verdict };

  function renderCatalogue(domain: string, products: ShopifyProduct[]) {
    if (!results) return;
    results.innerHTML = "";
    results.hidden = false;

    const scanned: Scanned[] = products.map((p) => {
      const text = rawText(p.body_html || "");
      return { p, text, words: wordCount(text), verdict: kdetect(p.body_html || "") };
    });
    const protectedCount = scanned.filter((s) => s.verdict.found).length;
    const totalWords = scanned.reduce((a, s) => a + s.words, 0);
    const imgs = allImages(products);
    const state =
      protectedCount === 0 ? "exposed" : protectedCount === products.length ? "protected" : "partial";

    // Verdict banner
    const banner = el("div", `sc-verdict is-${state}`);
    const vIcon = el("span", "sc-verdict__icon");
    vIcon.setAttribute("aria-hidden", "true");
    vIcon.textContent = state === "exposed" ? "⚠" : "🛡";
    const titles: Record<string, string> = {
      exposed: "Your copy is public, and nothing ties it back to you",
      partial: "Partly protected: some of this copy carries a Kirpik watermark",
      protected: "Protected: this store's copy carries Kirpik watermarks",
    };
    const subs: Record<string, string> = {
      exposed: `On ${domain}, ${products.length} products and roughly ${totalWords.toLocaleString()} words of product copy are sitting in the public feed right now, ready to paste. If any of it is stolen, there is nothing in the text to prove it was yours.`,
      partial: `We found ${products.length} products on ${domain}. ${protectedCount} carry a Kirpik watermark in their descriptions; the rest are unmarked and untraceable if copied.`,
      protected: `We found ${products.length} products on ${domain}, and every description carries a Kirpik watermark. Even scraped straight from this feed, the copy stays traceable to its owner.`,
    };
    const vText = el("div", "sc-verdict__text");
    vText.append(el("h2", "sc-verdict__title", titles[state]));
    vText.append(el("p", "sc-verdict__sub", subs[state]));
    banner.append(vIcon, vText);
    results.append(banner);

    // Toolbar
    const toolbar = el("div", "sc-toolbar");
    toolbar.append(
      el(
        "p",
        "sc-toolbar__count",
        `${products.length} products · ~${totalWords.toLocaleString()} words of copy · ${imgs.length} images`
      )
    );
    const actions = el("div", "sc-toolbar__actions");
    const copyAllBtn = el("button", "btn btn--primary sc-dlall") as HTMLButtonElement;
    copyAllBtn.type = "button";
    copyAllBtn.innerHTML = `<span class="sc-dlall__label">⧉ Copy every description (${products.length} products)</span>`;
    copyAllBtn.addEventListener("click", () => copyAllText(scanned, copyAllBtn));
    const zipBtn = el("button", "btn btn--ghost sc-dlall") as HTMLButtonElement;
    zipBtn.type = "button";
    zipBtn.innerHTML = `<span class="sc-dlall__label">⬇ Images too (${imgs.length}, ZIP)</span>`;
    zipBtn.addEventListener("click", () => downloadAllZip(domain, imgs, zipBtn));
    actions.append(copyAllBtn, zipBtn);
    toolbar.append(actions);
    results.append(toolbar);

    if (products.length > SHOW_LIMIT) {
      results.append(
        el(
          "p",
          "sc-note",
          `Showing the first ${SHOW_LIMIT} of ${products.length} products. The buttons above cover the whole catalogue.`
        )
      );
    }

    // Grid of product tiles
    const grid = el("div", "sc-grid");
    for (const s of scanned.slice(0, SHOW_LIMIT)) grid.append(renderTile(domain, s));
    results.append(grid);
  }

  function renderTile(domain: string, s: Scanned): HTMLElement {
    const { p, text, words, verdict } = s;
    const tile = el("article", "sc-tile card");

    // Header row: pill + thumbnail
    const head = el("div", "sc-tile__head");
    const pill = el(
      "span",
      `sc-pill ${verdict.found ? "sc-pill--ok" : "sc-pill--bad"}`,
      verdict.found ? "✓ Protected" : "● Exposed"
    );
    head.append(pill);
    const images = p.images || (p.image ? [p.image] : []);
    if (images[0]?.src) {
      const im = el("img", "sc-tile__thumb") as HTMLImageElement;
      im.src = images[0].src;
      im.alt = p.title;
      im.loading = "lazy";
      head.append(im);
    }
    tile.append(head);

    const body = el("div", "sc-tile__body");
    body.append(el("h3", "sc-tile__title", p.title));

    // The description is the point: show a generous excerpt.
    const display = displayText(p.body_html || "");
    body.append(
      el("p", "sc-tile__desc", display ? truncate(display, 320) : "No description on this product.")
    );

    // Detection readout
    const hud = el("div", "sc-tile__hud");
    if (verdict.found) {
      hud.append(el("span", "sc-tile__hudline sc-tile__hudline--ok", `✓ watermark detected · code ${verdict.code}`));
      hud.append(
        el("span", "sc-tile__hudline", `security markers ${verdict.markers} · confidence ${verdict.conf}%`)
      );
    } else {
      hud.append(el("span", "sc-tile__hudline", `no watermark · ${words.toLocaleString()} words, free to take`));
    }
    body.append(hud);

    // Actions
    const row = el("div", "sc-tile__actions");
    if (text) {
      const copyBtn = el("button", "sc-mini", "Copy text") as HTMLButtonElement;
      copyBtn.type = "button";
      copyBtn.setAttribute("aria-label", `Copy the description for ${p.title}`);
      copyBtn.addEventListener("click", () => copyText(text, copyBtn));
      row.append(copyBtn);
    }
    const jsonLink = el("a", "sc-mini") as HTMLAnchorElement;
    jsonLink.href = `https://${domain}/products/${p.handle}.json`;
    jsonLink.target = "_blank";
    jsonLink.rel = "noopener nofollow";
    jsonLink.textContent = "Raw .json";
    row.append(jsonLink);
    if (images.length) {
      row.append(el("span", "sc-tile__imgcount", `${images.length} image${images.length === 1 ? "" : "s"}`));
    }
    body.append(row);

    tile.append(body);
    return tile;
  }

  // --- Actions ------------------------------------------------------------------
  async function copyText(text: string, btn: HTMLButtonElement) {
    try {
      await navigator.clipboard.writeText(text);
      flash(btn, "Copied ✓");
    } catch {
      flash(btn, "Press Ctrl+C");
    }
  }

  async function copyAllText(scanned: Scanned[], btn: HTMLButtonElement) {
    const label = btn.querySelector(".sc-dlall__label") as HTMLElement | null;
    const chunks = scanned
      .filter((s) => s.text)
      .map((s) => `## ${s.p.title}\n\n${s.text}`);
    const blob = chunks.join("\n\n----\n\n");
    try {
      await navigator.clipboard.writeText(blob);
      if (label) label.textContent = `Copied ${chunks.length} descriptions to your clipboard`;
    } catch {
      if (label) label.textContent = "Clipboard blocked, try a single product";
    }
    setTimeout(() => {
      if (label) label.textContent = `⧉ Copy every description (${scanned.length} products)`;
    }, 4000);
  }

  async function downloadAllZip(
    domain: string,
    imgs: { src: string; name: string }[],
    btn: HTMLButtonElement
  ) {
    const label = btn.querySelector(".sc-dlall__label") as HTMLElement | null;
    const setLabel = (t: string) => {
      if (label) label.textContent = t;
    };
    btn.disabled = true;
    const files: Record<string, Uint8Array> = {};
    const used = new Set<string>();
    let done = 0;

    const jobs = imgs.map((img, i) => {
      let name = img.name || `image-${i + 1}`;
      if (used.has(name)) {
        const dot = name.lastIndexOf(".");
        name = dot > 0 ? `${name.slice(0, dot)}-${i + 1}${name.slice(dot)}` : `${name}-${i + 1}`;
      }
      used.add(name);
      return { src: img.src, name };
    });

    const POOL = 8;
    let next = 0;
    async function worker() {
      while (next < jobs.length) {
        const job = jobs[next++];
        try {
          const res = await fetch(job.src);
          files[job.name] = new Uint8Array(await res.arrayBuffer());
        } catch {
          /* skip images that fail */
        }
        done++;
        setLabel(`Fetching images… ${done} of ${jobs.length}`);
      }
    }
    await Promise.all(Array.from({ length: Math.min(POOL, jobs.length) }, worker));

    setLabel("Building catalogue.zip…");
    try {
      const zipped = zipSync(files, { level: 0 });
      const blob = new Blob([zipped], { type: "application/zip" });
      const safe = domain.replace(/[^a-z0-9.-]/gi, "-");
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `${safe}-catalogue.zip`;
      document.body.append(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      setLabel(`⬇ Downloaded ${Object.keys(files).length} images`);
    } catch {
      setLabel("Couldn't build the zip");
    } finally {
      setTimeout(() => {
        setLabel(`⬇ Images too (${imgs.length}, ZIP)`);
        btn.disabled = false;
      }, 4000);
    }
  }

  function flash(btn: HTMLButtonElement, msg: string, restore?: string) {
    const original = restore ?? btn.textContent ?? "";
    btn.textContent = msg;
    btn.classList.add("is-flash");
    setTimeout(() => {
      btn.textContent = original;
      btn.classList.remove("is-flash");
    }, 1600);
  }

  function renderFeedLinks(domain: string) {
    if (!feedLinks) return;
    feedLinks.innerHTML = "";
    const links: [string, string][] = [
      [`https://${domain}/products.json`, "/products.json"],
      [`https://${domain}/collections/all/products.json`, "/collections/all/products.json"],
      [`https://${domain}/sitemap.xml`, "/sitemap.xml"],
    ];
    for (const [href, label] of links) {
      const a = el("a", "sc-feedlink") as HTMLAnchorElement;
      a.href = href;
      a.target = "_blank";
      a.rel = "noopener nofollow";
      a.textContent = label;
      feedLinks.append(a);
    }
  }

  // --- Paste checker -------------------------------------------------------------
  const pasteInput = document.getElementById("sc-paste-input") as HTMLTextAreaElement | null;
  const pasteBtn = document.getElementById("sc-paste-btn") as HTMLButtonElement | null;
  const pasteResult = document.getElementById("sc-paste-result") as HTMLElement | null;

  pasteBtn?.addEventListener("click", () => {
    if (!pasteInput || !pasteResult) return;
    const text = pasteInput.value;
    pasteResult.innerHTML = "";
    if (wordCount(text) < 10) {
      pasteResult.append(el("p", "sc-paste__msg", "Paste a little more text, at least a couple of sentences."));
      return;
    }
    const v = kdetect(text);
    const hud = el("div", "hud sc-paste__hud");
    if (v.found) {
      hud.innerHTML = `<span class="ok">✓ WATERMARK DETECTED</span><br>store watermark code <b>${v.code}</b><br>security markers <b>${v.markers}</b> · confidence <b>${v.conf}%</b><br><span>This text is protected by Kirpik and traceable to its owner.</span>`;
    } else {
      hud.innerHTML = `<span>NO KIRPIK WATERMARK FOUND</span><br><span>Nothing in this text ties it to an owner. If it is yours, that is the problem worth fixing.</span>`;
    }
    pasteResult.append(hud);
  });

  // --- Orchestration -----------------------------------------------------------
  type CheckResult = {
    status: "invalid" | "exposed" | "partial" | "protected" | "empty" | "not-shopify" | "error";
    domain?: string;
    products?: number;
    words?: number;
    protectedProducts?: number;
  };

  async function runCheck(raw: string): Promise<CheckResult> {
    const domain = normalizeDomain(raw);
    if (!domain) {
      renderMessage("error", raw || "that address");
      return { status: "invalid" };
    }
    if (input) input.value = domain;
    if (howBlock) howBlock.hidden = false;
    setBusy(true);
    if (results) {
      results.hidden = false;
      results.innerHTML = "";
      const wrap = el("div", "sc-loading");
      wrap.append(el("span", "sc-spinner"));
      wrap.append(el("p", "sc-loading__text", `Reading the public feed for ${domain}…`));
      results.append(wrap);
    }
    try {
      const products = await fetchCatalogue(domain);
      renderFeedLinks(domain);
      if (!products.length) {
        renderMessage("empty", domain);
        return { status: "empty", domain };
      }
      renderCatalogue(domain, products);
      const scanned = products.map((p) => ({
        words: wordCount(rawText(p.body_html || "")),
        found: kdetect(p.body_html || "").found,
      }));
      const protectedProducts = scanned.filter((s) => s.found).length;
      const words = scanned.reduce((a, s) => a + s.words, 0);
      return {
        status:
          protectedProducts === 0
            ? "exposed"
            : protectedProducts === products.length
              ? "protected"
              : "partial",
        domain,
        products: products.length,
        words,
        protectedProducts,
      };
    } catch (err) {
      const msg = err instanceof Error ? err.message : "";
      renderMessage(msg === "error" ? "error" : "notshopify", domain);
      return { status: msg === "error" ? "error" : "not-shopify", domain };
    } finally {
      setBusy(false);
    }
  }

  // --- Wiring ------------------------------------------------------------------
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (input) runCheck(input.value);
  });

  const params = new URLSearchParams(window.location.search);
  const prefill = params.get("url");
  if (prefill) {
    if (input) input.value = prefill;
    runCheck(prefill);
  }

  // --- WebMCP ------------------------------------------------------------------
  // Expose this page's real capability to AI agents in the browser. Feature-
  // detected: a no-op where navigator.modelContext is unavailable.
  const mc = (navigator as any).modelContext;
  if (mc && typeof mc.provideContext === "function") {
    try {
      mc.provideContext({
        tools: [
          {
            name: "check_shopify_store_text_protection",
            description:
              "Check what a scraper can read from a Shopify store's public products.json feed (every product description as raw text), and whether that copy carries a Kirpik invisible text watermark. Runs entirely in the browser against the public feed.",
            inputSchema: {
              type: "object",
              properties: {
                url: {
                  type: "string",
                  description: "The Shopify store domain or URL, e.g. yourstore.com",
                },
              },
              required: ["url"],
            },
            async execute(args: { url?: string }) {
              const r = await runCheck(String(args?.url ?? ""));
              let text: string;
              switch (r.status) {
                case "exposed":
                  text = `${r.domain} is a Shopify store. ${r.products} products and about ${r.words} words of product copy are publicly readable via /products.json right now. None of it carries a Kirpik watermark, so a stolen copy has nothing tying it back to the store. Storefront "content protection" scripts do not affect this feed.`;
                  break;
                case "partial":
                  text = `${r.domain} is a Shopify store with ${r.products} products. ${r.protectedProducts} descriptions carry a Kirpik invisible watermark and are traceable; the rest are unmarked.`;
                  break;
                case "protected":
                  text = `${r.domain} is a Shopify store with ${r.products} products, and every description carries a Kirpik invisible watermark. Copies taken from the feed or the page remain traceable to the owner.`;
                  break;
                case "empty":
                  text = `${r.domain} is on Shopify but its public products feed is empty (new or password-protected store).`;
                  break;
                case "not-shopify":
                  text = `${r.domain} does not expose a standard Shopify products.json feed. It may not be on Shopify, or it may be a headless or custom setup.`;
                  break;
                case "invalid":
                  text = "That does not look like a valid store domain. Provide something like yourstore.com.";
                  break;
                default:
                  text = `Could not complete the check for ${r.domain ?? "that store"}.`;
              }
              return {
                content: [{ type: "text", text }],
                structuredContent: r,
              };
            },
          },
        ],
      });
    } catch {
      /* WebMCP unavailable or rejected — ignore. */
    }
  }
</script>

