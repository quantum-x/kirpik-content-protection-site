---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE } from "../config";

const shop = SITE.shopifyAppUrl;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Kirpik Store Content Check",
  applicationCategory: "SecurityApplication",
  operatingSystem: "Web",
  url: `${SITE.url}/site-check/`,
  description:
    "Check whether your Shopify store's content is protected. Reads your public product, blog and page feeds the way a content thief does, and reports whether the text carries a Kirpik watermark.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Base
  title="Is your store's content protected?"
  description="Enter your Shopify store and see every product description, blog post and page the way a content thief sees it, and whether anything in it identifies you as the owner."
  jsonLd={jsonLd}
>
  <!-- ============================ HERO / INPUT ======================= -->
  <section class="sc-hero">
    <div class="container narrow sc-hero__inner">
      <h1 class="sc-hero__title">Is your store's content protected?</h1>
      <p class="lead sc-hero__lead">
        Enter your Shopify store address. You will see every product
        description, blog post and page on your store the way a content thief
        sees it, ready to copy, and whether anything in it identifies you as
        the owner.
      </p>

      <form class="sc-form" id="sc-form" role="search">
        <label class="sc-form__field">
          <span class="sr-only">Your Shopify store URL</span>
          <span class="sc-form__lock" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><rect x="4" y="10" width="16" height="10" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="2"/></svg>
          </span>
          <input
            type="text"
            id="sc-url"
            name="url"
            inputmode="url"
            autocomplete="url"
            spellcheck="false"
            placeholder="yourstore.com"
            aria-label="Your Shopify store URL"
            required
          />
        </label>
        <button class="btn btn--primary sc-form__btn" type="submit" id="sc-submit">
          <span class="sc-form__btn-label">Check my store</span>
        </button>
      </form>
      <p class="sc-hero__note">
        Runs in your browser · We never see your store or its data · No login
      </p>
    </div>
  </section>

  <!-- ============================ RESULTS ============================ -->
  <section class="sc-results container" id="sc-results" data-shop={shop} hidden aria-live="polite"></section>

  <!-- ====================== HOW DOES THIS WORK? ===================== -->
  <section class="section section--tone" id="how" hidden>
    <div class="container narrow">
      <h2 class="sc-how__title">Shopify exposes direct feeds of your products, blogs and pages.</h2>
      <div class="sc-how prose">
        <p>
          Shopify publishes every store's content through machine-readable feeds so that search
          engines, shopping channels and integrations can read it without visiting the
          storefront. The feeds are public by design, and they carry your full text:
        </p>
        <ul>
          <li><code>/products.json</code> holds every product with its complete description, 250 per request.</li>
          <li><code>/blogs/&lt;name&gt;.atom</code> serves each blog's articles as a feed, full text included (<code>.rss</code> and <code>.xml</code> variants exist too).</li>
          <li><code>/sitemap.xml</code> lists every product, page and blog article on the store.</li>
        </ul>
        <p>
          Apps that "block copying" run a script on the storefront page. These feeds are not the
          storefront page. The script never loads, the data comes straight from Shopify, and the
          text arrives ready to paste. That is why this check works regardless of what is
          installed on the store.
        </p>
        <p class="sc-how__try">Open your store's raw feeds yourself:</p>
        <div class="sc-how__links" id="sc-feed-links">
          <span class="sc-how__hint">Run a check above and your store's direct feed links appear here.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================= THE HOOK ========================= -->
  <section class="section section--ink sc-hook">
    <div class="container narrow">
      <h2 class="sc-hook__title">What you can do about it.</h2>
      <p class="lead sc-hook__lead">
        These feeds cannot be closed, and your store needs them: search engines
        and sales channels read them every day. What you control is whether
        stolen content can be proven yours.
      </p>

      <div class="sc-hook__split">
        <div class="sc-hook__col sc-hook__col--bad">
          <h3>Content without a watermark</h3>
          <ul>
            <li>Reads perfectly. Pastes perfectly. Proves nothing.</li>
            <li>Once it is on someone else's page, it is your word against theirs.</li>
            <li>Hosts and marketplaces will not act on "mine looks older".</li>
            <li>Search engines may pick the thief's page as the original.</li>
          </ul>
        </div>
        <div class="sc-hook__col sc-hook__col--good">
          <h3>Content with a Kirpik watermark</h3>
          <p>
            Kirpik embeds an invisible watermark in the text itself, carrying
            your store's unique watermark code. However the text leaves,
            <strong>scraped from a feed, pasted from the page, exported and
            re-imported</strong>, the watermark stays embedded.
          </p>
          <p>
            When you find stolen content, Kirpik generates a
            <strong>Proof of Ownership Certificate</strong>: dated,
            independently verifiable, and built for DMCA takedowns.
          </p>
        </div>
      </div>

      <div class="sc-hook__cta">
        <a class="btn btn--primary" href={shop} rel="noopener" target="_blank">Install now for free</a>
        <a class="btn btn--light" href="/how-it-works/">See how Kirpik works →</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  type ShopifyImage = { id?: number; src: string; alt?: string | null };
  type ShopifyProduct = {
    id: number;
    title: string;
    handle: string;
    body_html?: string;
    images?: ShopifyImage[];
    image?: ShopifyImage | null;
  };

  const form = document.getElementById("sc-form") as HTMLFormElement | null;
  const input = document.getElementById("sc-url") as HTMLInputElement | null;
  const submit = document.getElementById("sc-submit") as HTMLButtonElement | null;
  const btnLabel = submit?.querySelector(".sc-form__btn-label") as HTMLElement | null;
  const results = document.getElementById("sc-results") as HTMLElement | null;
  const feedLinks = document.getElementById("sc-feed-links") as HTMLElement | null;
  const howBlock = document.getElementById("how") as HTMLElement | null;
  const SHOP_URL = results?.getAttribute("data-shop") || "https://apps.shopify.com/kirpik-content-protection";

  // Same-origin on kirpik.app; the deployed worker is used from anywhere else
  // (local preview) via CORS.
  const PROXY = location.hostname.endsWith("kirpik.app") ? "" : "https://kirpik.app";

  const el = (tag: string, cls?: string, text?: string) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  };

  // --- Detection (runs locally; returns a verdict for a block of text) ----
  const q0 = [0x2008, 0x2004, 0x2005, 0x2009];
  const q1: Record<number, number> = {};
  q0.forEach((c, i) => (q1[c] = i));
  const q2: number[] = new Array(256);
  for (let i = 0; i < 256; i++) {
    let c = i;
    for (let j = 0; j < 8; j++) c = c & 0x80 ? ((c << 1) ^ 0x07) & 0xff : (c << 1) & 0xff;
    q2[i] = c;
  }
  function q3(bits: number[]): number {
    const bytes: number[] = [];
    for (let i = 0; i < bits.length; i += 8) {
      let b = 0;
      for (let j = 0; j < 8; j++) b = (b << 1) | (bits[i + j] || 0);
      bytes.push(b);
    }
    let c = 0;
    for (const b of bytes) c = q2[(c ^ b) & 0xff];
    return c;
  }
  function q4(bits: number[]): number {
    let v = 0;
    for (const b of bits) v = (v << 1) | b;
    return v;
  }
  type Verdict = { found: boolean; code?: string; markers: number; total: number; conf: number };
  function kdetect(text: string): Verdict {
    const bits: number[] = [];
    for (const ch of text) {
      const v = q1[ch.codePointAt(0) as number];
      if (v !== undefined) bits.push(v >> 1, v & 1);
    }
    if (bits.length < 28) return { found: false, markers: 0, total: 0, conf: 0 };
    let best: { n: number; w: number; code: number; total: number } | null = null;
    for (let off = 0; off < 28; off++) {
      if (bits.length - off < 28) break;
      const total = Math.floor((bits.length - off) / 28);
      const votes = new Map<number, number>();
      let n = 0;
      for (let i = 0; i < total; i++) {
        const s = off + i * 28;
        const chunk = bits.slice(s, s + 28);
        const data = chunk.slice(0, 20);
        const sum = q4(chunk.slice(20, 28));
        const code = q4(chunk.slice(4, 20));
        if (q3(data) !== sum || code === 0) continue;
        n++;
        votes.set(code, (votes.get(code) || 0) + 1);
      }
      let w = 0, code = 0;
      for (const [k, v] of votes) if (v > w) { w = v; code = k; }
      if (!best || n > best.n || (n === best.n && w > best.w)) best = { n, w, code, total };
    }
    if (!best || best.n < 2 || best.w < 2) {
      return { found: false, markers: best?.n ?? 0, total: best?.total ?? 0, conf: 0 };
    }
    return {
      found: true,
      code: "#" + best.code.toString(36).toUpperCase(),
      markers: best.n,
      total: best.total,
      conf: Math.round((best.w / best.total) * 1000) / 10,
    };
  }

  // --- Text helpers --------------------------------------------------------
  function rawText(html: string): string {
    const doc = new DOMParser().parseFromString(html || "", "text/html");
    return (doc.body.textContent || "").trim();
  }
  function mainText(html: string): string {
    const doc = new DOMParser().parseFromString(html || "", "text/html");
    doc.querySelectorAll("script, style, noscript, svg, nav, header, footer").forEach((n) => n.remove());
    const root = doc.querySelector("main") || doc.body;
    return (root.textContent || "").trim();
  }
  function displayText(s: string): string {
    return s.replace(/\s+/g, " ").trim();
  }
  function wordCount(s: string): number {
    return s ? s.split(/\s+/).filter(Boolean).length : 0;
  }
  function truncate(s: string, n: number): string {
    return s.length > n ? s.slice(0, n).trimEnd() + "…" : s;
  }

  // --- Domain handling ------------------------------------------------------
  function normalizeDomain(raw: string): string | null {
    let v = (raw || "").trim().toLowerCase();
    if (!v) return null;
    v = v.replace(/^https?:\/\//, "").replace(/^www\./, "");
    v = v.split("/")[0].split("?")[0].split("#")[0].trim();
    if (!v || !v.includes(".") || /\s/.test(v)) return null;
    if (!/^[a-z0-9.-]+\.[a-z]{2,}$/.test(v)) return null;
    return v;
  }

  // --- Fetching ---------------------------------------------------------------
  const MAX_PAGES = 8; // 8 x 250 = up to 2000 products scanned
  const SHOW_LIMIT = 24;
  const MAX_BLOGS = 3;
  const MAX_POSTS = 9;
  const MAX_STORE_PAGES = 10;

  async function fetchCatalogue(domain: string): Promise<ShopifyProduct[]> {
    const products: ShopifyProduct[] = [];
    for (let page = 1; page <= MAX_PAGES; page++) {
      const url = `https://${domain}/products.json?limit=250&page=${page}`;
      const res = await fetch(url, { headers: { Accept: "application/json" } });
      if (!res.ok) {
        if (page === 1) throw new Error(`HTTP ${res.status}`);
        break;
      }
      const ct = res.headers.get("content-type") || "";
      if (!ct.includes("json")) {
        if (page === 1) throw new Error("not-json");
        break;
      }
      const data = await res.json();
      const batch: ShopifyProduct[] = data.products || [];
      products.push(...batch);
      if (batch.length < 250) break;
    }
    return products;
  }

  async function proxyFetch(params: string): Promise<string | null> {
    try {
      const res = await fetch(`${PROXY}/sc-fetch?${params}`);
      if (!res.ok) return null;
      return await res.text();
    } catch {
      return null;
    }
  }

  type Post = { title: string; url: string; text: string; verdict: Verdict; words: number };
  type StorePage = { title: string; url: string; text: string; verdict: Verdict; words: number };

  function locsOf(xml: string): string[] {
    return [...xml.matchAll(/<loc>\s*([^<\s]+)\s*<\/loc>/g)].map((m) => m[1]);
  }

  async function fetchBlogAndPages(domain: string): Promise<{ posts: Post[]; pages: StorePage[]; blogHandles: string[] }> {
    const empty = { posts: [], pages: [], blogHandles: [] as string[] };
    const index = await proxyFetch(`d=${encodeURIComponent(domain)}&t=sitemap`);
    if (!index) return empty;
    const parts = locsOf(index)
      .map((u) => u.match(/\/(sitemap[a-z0-9_]*\.xml(?:\?[^<\s"]*)?)$/)?.[1])
      .map((p) => p?.replace(/&amp;/g, "&"))
      .filter(Boolean) as string[];
    const blogParts = parts.filter((p) => p.startsWith("sitemap_blogs")).slice(0, 2);
    const pageParts = parts.filter((p) => p.startsWith("sitemap_pages")).slice(0, 2);

    // Blogs: discover handles from the blogs sitemap, then read each feed.
    const blogHandles = new Set<string>();
    for (const part of blogParts) {
      const xml = await proxyFetch(`d=${encodeURIComponent(domain)}&t=smpart&f=${encodeURIComponent(part)}`);
      if (!xml) continue;
      for (const u of locsOf(xml)) {
        const h = u.match(/\/blogs\/([a-zA-Z0-9._-]+)\//)?.[1];
        if (h) blogHandles.add(h);
        if (blogHandles.size >= MAX_BLOGS) break;
      }
    }
    const posts: Post[] = [];
    await Promise.all(
      [...blogHandles].map(async (h) => {
        const atom = await proxyFetch(`d=${encodeURIComponent(domain)}&t=atom&h=${encodeURIComponent(h)}`);
        if (!atom) return;
        const doc = new DOMParser().parseFromString(atom, "text/xml");
        for (const entry of [...doc.querySelectorAll("entry")].slice(0, MAX_POSTS)) {
          const title = entry.querySelector("title")?.textContent?.trim() || "Untitled";
          const link = entry.querySelector("link")?.getAttribute("href") || "";
          const content = entry.querySelector("content")?.textContent || "";
          const text = rawText(content);
          if (!text) continue;
          posts.push({ title, url: link, text, verdict: kdetect(content), words: wordCount(text) });
        }
      })
    );

    // Pages: discover handles from the pages sitemap, fetch each page.
    const pageHandles: { h: string; url: string }[] = [];
    for (const part of pageParts) {
      const xml = await proxyFetch(`d=${encodeURIComponent(domain)}&t=smpart&f=${encodeURIComponent(part)}`);
      if (!xml) continue;
      for (const u of locsOf(xml)) {
        const h = u.match(/\/pages\/([a-zA-Z0-9._-]+)\/?$/)?.[1];
        if (h && !pageHandles.some((p) => p.h === h)) pageHandles.push({ h, url: u });
        if (pageHandles.length >= MAX_STORE_PAGES) break;
      }
    }
    const pages: StorePage[] = [];
    await Promise.all(
      pageHandles.map(async ({ h, url }) => {
        const html = await proxyFetch(`d=${encodeURIComponent(domain)}&t=page&h=${encodeURIComponent(h)}`);
        if (!html) return;
        const text = mainText(html);
        if (wordCount(text) < 10) return;
        const title =
          new DOMParser().parseFromString(html, "text/html").querySelector("title")?.textContent?.split("–")[0].split("|")[0].trim() ||
          h.replace(/-/g, " ");
        pages.push({ title, url, text, verdict: kdetect(html), words: wordCount(text) });
      })
    );
    posts.sort((a, b) => b.words - a.words);
    pages.sort((a, b) => b.words - a.words);
    return { posts: posts.slice(0, MAX_POSTS), pages, blogHandles: [...blogHandles] };
  }

  // --- Rendering ---------------------------------------------------------------
  function setBusy(busy: boolean) {
    if (!submit || !btnLabel) return;
    submit.disabled = busy;
    btnLabel.textContent = busy ? "Checking…" : "Check my store";
  }

  function renderMessage(kind: "notshopify" | "empty" | "error", domain: string) {
    if (!results) return;
    results.innerHTML = "";
    results.hidden = false;
    const card = el("div", "sc-msg");
    const copy: Record<string, [string, string]> = {
      notshopify: [
        "This isn't a standard Shopify storefront",
        `We couldn't read a public products feed at ${domain}. It may not be on Shopify, or it may be a headless or custom setup. Standard Shopify stores expose this feed automatically. If you have one, try your ".myshopify.com" address.`,
      ],
      empty: [
        "Shopify detected, but no public content found",
        `${domain} is on Shopify, but its public feeds are currently empty. New or password-protected stores can look like this.`,
      ],
      error: [
        "Something went wrong reading that store",
        `We couldn't complete the check for ${domain}. Double-check the address and try again.`,
      ],
    };
    const [title, body] = copy[kind];
    card.append(el("h2", "sc-msg__title", title), el("p", "sc-msg__body", body));
    results.append(card);
  }

  type Scanned = { p: ShopifyProduct; text: string; words: number; verdict: Verdict };

  function verdictLine(hud: HTMLElement, v: Verdict, words: number) {
    if (v.found) {
      hud.append(el("span", "sc-tile__hudline sc-tile__hudline--ok", `✓ Watermark detected · code ${v.code}`));
      hud.append(el("span", "sc-tile__hudline", `Confidence ${v.conf}%`));
    } else {
      hud.append(el("span", "sc-tile__hudline", `${words.toLocaleString()} words · No watermark · Unprotected`));
    }
  }

  function actionsRow(text: string, ariaName: string): HTMLElement {
    const row = el("div", "sc-tile__actions");
    if (text) {
      const copyBtn = el("button", "sc-mini", "Copy text") as HTMLButtonElement;
      copyBtn.type = "button";
      copyBtn.setAttribute("aria-label", `Copy the text of ${ariaName}`);
      copyBtn.addEventListener("click", () => copyText(text, copyBtn));
      row.append(copyBtn);
    }
    const protect = el("a", "sc-mini sc-mini--protect", "Protect now") as HTMLAnchorElement;
    protect.href = SHOP_URL;
    protect.target = "_blank";
    protect.rel = "noopener";
    row.append(protect);
    return row;
  }

  function renderResults(domain: string, scanned: Scanned[], posts: Post[], pages: StorePage[]) {
    if (!results) return;
    results.innerHTML = "";
    results.hidden = false;

    const allVerdicts = [
      ...scanned.map((s) => s.verdict),
      ...posts.map((p) => p.verdict),
      ...pages.map((p) => p.verdict),
    ];
    const protectedCount = allVerdicts.filter((v) => v.found).length;
    const totalItems = allVerdicts.length;
    const totalWords =
      scanned.reduce((a, s) => a + s.words, 0) +
      posts.reduce((a, p) => a + p.words, 0) +
      pages.reduce((a, p) => a + p.words, 0);
    const state =
      protectedCount === 0 ? "exposed" : protectedCount === totalItems ? "protected" : "partial";

    const countParts = [`${scanned.length} products`];
    if (posts.length) countParts.push(`${posts.length} blog posts`);
    if (pages.length) countParts.push(`${pages.length} pages`);
    const countsText = countParts.join(", ").replace(/, ([^,]*)$/, " and $1");

    // Verdict banner
    const banner = el("div", `sc-verdict is-${state}`);
    const vIcon = el("span", "sc-verdict__icon");
    vIcon.setAttribute("aria-hidden", "true");
    vIcon.textContent = state === "exposed" ? "⚠" : "🛡";
    const titles: Record<string, string> = {
      exposed: "None of your content is protected",
      partial: "Partly protected: some of this content carries a Kirpik watermark",
      protected: "Protected: this store's content carries Kirpik watermarks",
    };
    const subs: Record<string, string> = {
      exposed: `On ${domain}, ${countsText}, roughly ${totalWords.toLocaleString()} words, are publicly readable right now. If any of it is stolen, nothing in the text proves it was yours.`,
      partial: `We read ${countsText} on ${domain}. ${protectedCount} of ${totalItems} items carry a Kirpik watermark; the rest are unmarked and untraceable if copied.`,
      protected: `We read ${countsText} on ${domain}, and every item carries a Kirpik watermark. Even taken straight from the public feeds, the text stays traceable to its owner.`,
    };
    const vText = el("div", "sc-verdict__text");
    vText.append(el("h2", "sc-verdict__title", titles[state]));
    vText.append(el("p", "sc-verdict__sub", subs[state]));
    if (state !== "protected") {
      const cta = el("a", "btn btn--primary sc-verdict__cta", "Protect your content now") as HTMLAnchorElement;
      cta.href = SHOP_URL;
      cta.target = "_blank";
      cta.rel = "noopener";
      vText.append(cta);
    }
    banner.append(vIcon, vText);
    results.append(banner);

    // Products
    if (scanned.length) {
      results.append(el("h3", "sc-section-head", "Products"));
      if (scanned.length > SHOW_LIMIT) {
        results.append(el("p", "sc-note", `Showing the first ${SHOW_LIMIT} of ${scanned.length} products.`));
      }
      const grid = el("div", "sc-grid");
      for (const s of scanned.slice(0, SHOW_LIMIT)) grid.append(renderProductTile(s));
      results.append(grid);
    }

    // Blog posts
    if (posts.length) {
      results.append(el("h3", "sc-section-head", "Blog posts"));
      const grid = el("div", "sc-grid");
      for (const p of posts) grid.append(renderTextTile(p.title, p.text, p.words, p.verdict));
      results.append(grid);
    }

    // Pages
    if (pages.length) {
      results.append(el("h3", "sc-section-head", "Pages"));
      const grid = el("div", "sc-grid");
      for (const p of pages) grid.append(renderTextTile(p.title, p.text, p.words, p.verdict));
      results.append(grid);
    }
  }

  function renderProductTile(s: Scanned): HTMLElement {
    const { p, text, words, verdict } = s;
    const tile = el("article", "sc-tile card");

    const head = el("div", "sc-tile__head");
    const pill = el(
      "span",
      `sc-pill ${verdict.found ? "sc-pill--ok" : "sc-pill--bad"}`,
      verdict.found ? "✓ Protected" : "● Exposed"
    );
    head.append(pill);
    const images = p.images || (p.image ? [p.image] : []);
    if (images[0]?.src) {
      const im = el("img", "sc-tile__thumb") as HTMLImageElement;
      im.src = images[0].src;
      im.alt = p.title;
      im.loading = "lazy";
      head.append(im);
    }
    tile.append(head);

    const body = el("div", "sc-tile__body");
    body.append(el("h4", "sc-tile__title", p.title));
    const display = displayText(text);
    body.append(el("p", "sc-tile__desc", display ? truncate(display, 300) : "No description on this product."));
    const hud = el("div", "sc-tile__hud");
    verdictLine(hud, verdict, words);
    body.append(hud);
    body.append(actionsRow(text, p.title));
    tile.append(body);
    return tile;
  }

  function renderTextTile(title: string, text: string, words: number, verdict: Verdict): HTMLElement {
    const tile = el("article", "sc-tile card");
    const head = el("div", "sc-tile__head");
    head.append(
      el(
        "span",
        `sc-pill ${verdict.found ? "sc-pill--ok" : "sc-pill--bad"}`,
        verdict.found ? "✓ Protected" : "● Exposed"
      )
    );
    tile.append(head);
    const body = el("div", "sc-tile__body");
    body.append(el("h4", "sc-tile__title", title));
    body.append(el("p", "sc-tile__desc", truncate(displayText(text), 300)));
    const hud = el("div", "sc-tile__hud");
    verdictLine(hud, verdict, words);
    body.append(hud);
    body.append(actionsRow(text, title));
    tile.append(body);
    return tile;
  }

  // --- Actions ------------------------------------------------------------------
  async function copyText(text: string, btn: HTMLButtonElement) {
    try {
      await navigator.clipboard.writeText(text);
      flash(btn, "Copied ✓");
    } catch {
      flash(btn, "Press Ctrl+C");
    }
  }

  function flash(btn: HTMLButtonElement, msg: string, restore?: string) {
    const original = restore ?? btn.textContent ?? "";
    btn.textContent = msg;
    btn.classList.add("is-flash");
    setTimeout(() => {
      btn.textContent = original;
      btn.classList.remove("is-flash");
    }, 1600);
  }

  function renderFeedLinks(domain: string, blogHandles: string[]) {
    if (!feedLinks) return;
    feedLinks.innerHTML = "";
    const links: [string, string][] = [
      [`https://${domain}/products.json`, "/products.json"],
      ...blogHandles.slice(0, 2).map((h): [string, string] => [`https://${domain}/blogs/${h}.atom`, `/blogs/${h}.atom`]),
      [`https://${domain}/sitemap.xml`, "/sitemap.xml"],
    ];
    for (const [href, label] of links) {
      const a = el("a", "sc-feedlink") as HTMLAnchorElement;
      a.href = href;
      a.target = "_blank";
      a.rel = "noopener nofollow";
      a.textContent = label;
      feedLinks.append(a);
    }
  }

  // --- Orchestration -----------------------------------------------------------
  type CheckResult = {
    status: "invalid" | "exposed" | "partial" | "protected" | "empty" | "not-shopify" | "error";
    domain?: string;
    products?: number;
    blogPosts?: number;
    pages?: number;
    words?: number;
    protectedItems?: number;
  };

  async function runCheck(raw: string): Promise<CheckResult> {
    const domain = normalizeDomain(raw);
    if (!domain) {
      renderMessage("error", raw || "that address");
      return { status: "invalid" };
    }
    if (input) input.value = domain;
    if (howBlock) howBlock.hidden = false;
    setBusy(true);
    if (results) {
      results.hidden = false;
      results.innerHTML = "";
      const wrap = el("div", "sc-loading");
      wrap.append(el("span", "sc-spinner"));
      wrap.append(el("p", "sc-loading__text", `Reading the public feeds for ${domain}…`));
      results.append(wrap);
    }
    try {
      const [products, extra] = await Promise.all([
        fetchCatalogue(domain),
        fetchBlogAndPages(domain),
      ]);
      renderFeedLinks(domain, extra.blogHandles);
      if (!products.length && !extra.posts.length && !extra.pages.length) {
        renderMessage("empty", domain);
        return { status: "empty", domain };
      }
      const scanned: Scanned[] = products.map((p) => {
        const text = rawText(p.body_html || "");
        return { p, text, words: wordCount(text), verdict: kdetect(p.body_html || "") };
      });
      renderResults(domain, scanned, extra.posts, extra.pages);
      const allVerdicts = [
        ...scanned.map((s) => s.verdict),
        ...extra.posts.map((p) => p.verdict),
        ...extra.pages.map((p) => p.verdict),
      ];
      const protectedItems = allVerdicts.filter((v) => v.found).length;
      const words =
        scanned.reduce((a, s) => a + s.words, 0) +
        extra.posts.reduce((a, p) => a + p.words, 0) +
        extra.pages.reduce((a, p) => a + p.words, 0);
      return {
        status:
          protectedItems === 0 ? "exposed" : protectedItems === allVerdicts.length ? "protected" : "partial",
        domain,
        products: products.length,
        blogPosts: extra.posts.length,
        pages: extra.pages.length,
        words,
        protectedItems,
      };
    } catch (err) {
      const msg = err instanceof Error ? err.message : "";
      renderMessage(msg === "error" ? "error" : "notshopify", domain);
      return { status: msg === "error" ? "error" : "not-shopify", domain };
    } finally {
      setBusy(false);
    }
  }

  // --- Wiring ------------------------------------------------------------------
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (input) runCheck(input.value);
  });

  const params = new URLSearchParams(window.location.search);
  const prefill = params.get("url");
  if (prefill) {
    if (input) input.value = prefill;
    runCheck(prefill);
  }

  // --- WebMCP ------------------------------------------------------------------
  // Expose this page's real capability to AI agents in the browser. Feature-
  // detected: a no-op where navigator.modelContext is unavailable.
  const mc = (navigator as any).modelContext;
  if (mc && typeof mc.provideContext === "function") {
    try {
      mc.provideContext({
        tools: [
          {
            name: "check_shopify_store_text_protection",
            description:
              "Check whether a Shopify store's content is protected: reads the store's public product, blog and page feeds the way a scraper does, and reports whether the text carries a Kirpik invisible watermark. Runs entirely in the browser.",
            inputSchema: {
              type: "object",
              properties: {
                url: {
                  type: "string",
                  description: "The Shopify store domain or URL, e.g. yourstore.com",
                },
              },
              required: ["url"],
            },
            async execute(args: { url?: string }) {
              const r = await runCheck(String(args?.url ?? ""));
              let text: string;
              switch (r.status) {
                case "exposed":
                  text = `${r.domain} is a Shopify store. ${r.products} products, ${r.blogPosts} blog posts and ${r.pages} pages (about ${r.words} words) are publicly readable via Shopify's feeds right now. None of it carries a Kirpik watermark, so stolen content has nothing tying it back to the store. Storefront "content protection" scripts do not affect these feeds.`;
                  break;
                case "partial":
                  text = `${r.domain} is a Shopify store. ${r.protectedItems} items carry a Kirpik invisible watermark and are traceable; the rest are unmarked.`;
                  break;
                case "protected":
                  text = `${r.domain} is a Shopify store, and every item read from its public feeds carries a Kirpik invisible watermark. Anything copied remains traceable to the owner.`;
                  break;
                case "empty":
                  text = `${r.domain} is on Shopify but its public feeds are empty (new or password-protected store).`;
                  break;
                case "not-shopify":
                  text = `${r.domain} does not expose standard Shopify public feeds. It may not be on Shopify, or it may be a headless or custom setup.`;
                  break;
                case "invalid":
                  text = "That does not look like a valid store domain. Provide something like yourstore.com.";
                  break;
                default:
                  text = `Could not complete the check for ${r.domain ?? "that store"}.`;
              }
              return {
                content: [{ type: "text", text }],
                structuredContent: r,
              };
            },
          },
        ],
      });
    } catch {
      /* WebMCP unavailable or rejected. Ignore. */
    }
  }
</script>

