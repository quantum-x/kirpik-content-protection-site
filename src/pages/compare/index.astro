---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import SiteCheckForm from "../../components/SiteCheckForm.astro";
import { SITE } from "../../config";
import { COMPETITORS_BY_POPULARITY, BLURBS } from "../../compare-data";

const apps = COMPETITORS_BY_POPULARITY;

// Every app must have a plain-words one-liner; fail the build if one is missing.
for (const c of apps) {
  if (!BLURBS[c.slug]) throw new Error(`Missing hub blurb for ${c.slug}`);
}

// Icons are fetched by scripts/gen-compare-icons.mjs; where one is missing the
// row falls back to a neutral letter tile. Resolved from the project root
// because the compiled module's own URL moves between dev and build.
const iconsDir = join(process.cwd(), "public", "compare-icons");
const icon = (slug: string) => (existsSync(join(iconsDir, `${slug}.png`)) ? `/compare-icons/${slug}.png` : null);
const initial = (name: string) => name.replace(/[^A-Za-z0-9]/g, "").charAt(0).toUpperCase() || "A";

type Answer = { text: string; yes?: boolean };
const YES: Answer = { text: "Yes", yes: true };
const NO: Answer = { text: "No" };

// The two questions, technique by technique.
const questionRows: { label: string; cells: [Answer, Answer, Answer, Answer] }[] = [
  { label: "Stops right-click copying in the browser", cells: [YES, NO, NO, NO] },
  { label: "Stops scrapers and feed copying", cells: [NO, NO, NO, NO] },
  { label: "Protects your text once it leaves your store", cells: [NO, NO, NO, YES] },
  { label: "Proves a stolen description was yours", cells: [NO, NO, NO, YES] },
  {
    label: "Produces evidence for a DMCA takedown",
    cells: [NO, NO, { text: "Reports matches, no proof" }, YES],
  },
];

const techniquePages = [
  { href: "/compare/techniques/", label: "All techniques, one table", desc: "Every protection technique in the category, side by side." },
  { href: "/compare/vs-copy-blockers/", label: "Copy and right-click blockers", desc: "What a storefront script can block, and the feeds it never touches." },
  { href: "/compare/vs-visible-watermarks/", label: "Visible watermarks", desc: "Marks that travel with a copied image, and why text carries nothing." },
  { href: "/compare/vs-content-credentials/", label: "Content Credentials and C2PA", desc: "Provenance metadata, and what happens to it when text is copied." },
  { href: "/compare/vs-zero-width-characters/", label: "Zero-width characters", desc: "Hidden characters pasted into text, and where the trick falls short." },
  { href: "/compare/vs-copy-monitors/", label: "Copy monitors", desc: "Scanners that find matching pages, and the ownership question they leave open." },
];

const abs = (path: string) => new URL(path, SITE.url).href;
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Kirpik vs other Shopify anti-theft apps",
  description:
    "Every relevant app in the Shopify App Store anti-theft category, compared with Kirpik's invisible text watermarking, ordered by review count.",
  numberOfItems: apps.length,
  itemListElement: apps.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: `${c.name} vs Kirpik`,
    url: abs(`/compare/${c.slug}/`),
  })),
};
---

<Base
  title="Kirpik vs other anti-theft apps"
  description="We analysed every app in Shopify's anti-theft category, over 90 of them, against two questions: does it prevent your content being stolen, and can you prove the infringement? None prevent theft. Here is what each one does."
  jsonLd={itemListJsonLd}
>
  <header class="chub">
    <div class="container narrow">
      <h1>Kirpik vs other anti-theft apps</h1>
      <p class="lead">
        We analysed every app in Shopify's anti-theft category, over 90 of them, against two simple
        questions: <strong>does it prevent your content being stolen</strong>, and
        <strong>if it is stolen, can you prove the infringement?</strong>
      </p>
      <p>
        None of them prevent theft. Shopify serves your content through different feeds for customers,
        search engines and AI tools. "Anti-theft" apps only try to lock down what a customer sees - but
        don't protect the other feeds that scrapers and content thieves use.
      </p>
      <p>
        Kirpik protects the text itself, detects stolen copies anywhere on the web, and issues Proof of
        Ownership Certificates for DMCA takedowns and enforcement.
      </p>
    </div>
  </header>

  <section class="section" style="padding-top:clamp(2rem, 4vw, 3rem)">
    <div class="container">
      <h2>The two questions</h2>
      <div class="tablewrap">
        <table class="qtable">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Question</span></th>
              <th scope="col">Blockers</th>
              <th scope="col">Image watermarks</th>
              <th scope="col">Monitors</th>
              <th scope="col" class="uscol">Kirpik</th>
            </tr>
          </thead>
          <tbody>
            {questionRows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {row.cells.map((a, i) => (
                  <td class:list={[{ uscol: i === 3, yes: a.yes }]}>{a.text}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <h2>Every app, compared</h2>
      <p class="sec-sub">
        All {apps.length} relevant apps in the category, ordered by review count. Each name links to a
        full side-by-side comparison with Kirpik.
      </p>
      <p class="sec-note">
        Seven more apps listed in the category do theme backups, consent banners and similar
        housekeeping rather than content protection, and are not compared.
      </p>
      <p class="filterrow">
        <input
          type="search"
          id="app-filter"
          placeholder="Filter by app name"
          aria-label="Filter by app name"
          autocomplete="off"
          spellcheck="false"
        />
      </p>
      <div class="tablewrap">
        <table class="apps">
          <thead>
            <tr>
              <th scope="col">App</th>
              <th scope="col">What it does</th>
              <th scope="col" class="num">Reviews</th>
            </tr>
          </thead>
          <tbody>
            {apps.map((c, i) => {
              const ic = icon(c.slug);
              return (
                <tr class:list={[{ hl: i < 27 }]}>
                  <td class="appcell">
                    <a href={`/compare/${c.slug}/`}>
                      {ic ? (
                        <img src={ic} alt="" width="30" height="30" loading="lazy" />
                      ) : (
                        <span class="tile" aria-hidden="true">{initial(c.name)}</span>
                      )}
                      <span class="appname">{c.name}</span>
                    </a>
                  </td>
                  <td class="blurb">{BLURBS[c.slug]}</td>
                  <td class="num">{typeof c.reviews === "number" ? c.reviews : "None yet"}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="table-note">The 27 most-reviewed apps are shaded.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container narrow">
      <h2>Techniques, not apps</h2>
      <p class="sec-sub">The same ground organised by how the protection works, rather than by app.</p>
      <ul class="techlist">
        {techniquePages.map((t) => (
          <li>
            <a href={t.href}>{t.label}</a>
            <span>{t.desc}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SiteCheckForm
    tone="band"
    heading="Is your store's content protected?"
    sub="Enter your Shopify store address and see exactly what a scraper sees, and whether your content is protected."
    cta="Check my store"
  />

  <section class="section" style="padding-top:clamp(1.6rem, 3vw, 2.4rem)">
    <div class="container narrow">
      <p class="foot-note">
        Every app on this page is described from its own public Shopify App Store listing, read in June
        and July 2026. Listings change, and features, pricing and review counts may differ today. App
        names and trademarks belong to their respective owners and are used for identification only.
        Kirpik is published by {SITE.developer} and has no affiliation with any app listed here except
        Tilkie, which is built by the same team; that relationship is disclosed on its comparison page.
        Nothing here is legal advice.
      </p>
    </div>
  </section>
</Base>

<style>
  .chub { padding-block: clamp(2.8rem, 2rem + 4vw, 5rem) 0; }
  .chub h1 { font-size: var(--fs-h1); margin-bottom: 1.2rem; }
  .chub .lead { margin-bottom: 1rem; }
  .chub p:not(.lead) { color: var(--ink-soft); line-height: 1.7; margin-bottom: 1rem; max-width: 70ch; }

  h2 { margin-bottom: 1.2rem; }
  .sec-sub { color: var(--ink-soft); margin: -0.4rem 0 1.4rem; max-width: 72ch; }
  .sec-note { color: var(--ink-soft); margin: -0.9rem 0 1.4rem; max-width: 72ch; }

  .filterrow { margin: 0 0 1rem; }
  .filterrow input {
    width: 100%; max-width: 340px;
    font: inherit; font-size: 0.95rem; color: var(--ink);
    background: #fff; border: 1.5px solid var(--line-strong); border-radius: var(--r-md);
    padding: 0.6em 0.9em; outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .filterrow input:focus { border-color: var(--orange); box-shadow: var(--ring); }

  .table-note { margin-top: 0.8rem; font-size: 0.88rem; color: var(--ink-faint); }

  .tablewrap { overflow-x: auto; }

  /* The two questions */
  .qtable { width: 100%; border-collapse: collapse; min-width: 720px; }
  .qtable th, .qtable td { padding: 1rem 1.1rem; border-bottom: 1px solid var(--line); }
  .qtable thead th { font-weight: 700; font-size: 0.98rem; color: var(--ink); text-align: center; }
  .qtable tbody th { font-weight: 600; font-size: 1.02rem; color: var(--ink); text-align: left; width: 34%; }
  .qtable td { text-align: center; font-size: 1rem; color: var(--ink-faint); }
  .qtable td.yes { color: var(--ink); font-weight: 700; }
  .qtable .uscol { background: var(--orange-tint); }
  .qtable td.uscol.yes { color: var(--orange-deep); }

  /* Every app, compared */
  .apps { width: 100%; border-collapse: collapse; min-width: 680px; }
  .apps th, .apps td { padding: 0.65rem 0.9rem; border-bottom: 1px solid var(--line); text-align: left; }
  .apps thead th { font-weight: 700; font-size: 0.92rem; color: var(--ink); }
  .apps .num { text-align: right; font-family: var(--font-mono); font-size: 0.9rem; color: var(--ink-soft); white-space: nowrap; }
  .apps thead .num { font-family: var(--font-sans); color: var(--ink); }
  .appcell a { display: flex; align-items: center; gap: 0.7rem; color: var(--ink); font-weight: 600; }
  .appcell a:hover .appname { color: var(--orange-deep); }
  .appcell img, .tile { width: 30px; height: 30px; border-radius: 7px; flex: none; }
  .appcell img { border: 1px solid var(--line); object-fit: cover; }
  .tile { display: grid; place-items: center; background: var(--sand); color: var(--ink-soft); font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600; }
  .appname { font-size: 0.97rem; }
  .blurb { color: var(--ink-soft); font-size: 0.95rem; }
  tr.hl { background: var(--surface); }
  tr.hl .appname { font-weight: 800; }

  /* Techniques */
  .techlist li { padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
  .techlist li:first-child { border-top: 1px solid var(--line); }
  .techlist a { font-weight: 700; color: var(--ink); }
  .techlist a:hover { color: var(--orange-deep); }
  .techlist span { display: block; margin-top: 0.15rem; color: var(--ink-soft); font-size: 0.95rem; }

  .foot-note { font-size: 0.85rem; color: var(--ink-faint); line-height: 1.65; }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>

<script>
  // Progressive enhancement: the table is fully rendered without JavaScript;
  // this only hides rows whose app name does not match the filter text.
  const filter = document.getElementById("app-filter") as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("table.apps tbody tr"));
  filter?.addEventListener("input", () => {
    const q = filter.value.trim().toLowerCase();
    for (const row of rows) {
      const name = row.querySelector(".appname")?.textContent?.toLowerCase() ?? "";
      row.hidden = q !== "" && !name.includes(q);
    }
  });
</script>
