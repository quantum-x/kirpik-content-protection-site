---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";

interface TechniqueRow {
  name: string;
  href?: string;
  us?: boolean;
  cells: [string, string, string, string];
}

const COLUMNS = [
  "Stops copying in the browser",
  "Protects text after it leaves your store",
  "Proves a stolen description was yours",
  "Produces evidence for a DMCA takedown",
];

const ROWS: TechniqueRow[] = [
  { name: "Kirpik", us: true, cells: ["-", "Yes", "Yes", "Yes"] },
  {
    name: "Copy blockers",
    href: "/compare/vs-copy-blockers/",
    cells: ["Easily bypassed", "No", "No", "No"],
  },
  {
    name: "Visible watermarks",
    href: "/compare/vs-visible-watermarks/",
    cells: ["No", "Images only", "No", "No"],
  },
  {
    name: "Content Credentials",
    href: "/compare/vs-content-credentials/",
    cells: ["No", "No", "No", "No"],
  },
  {
    name: "Zero-width characters",
    href: "/compare/vs-zero-width-characters/",
    cells: ["No", "No", "No", "No"],
  },
  {
    name: "Copy monitors",
    href: "/compare/vs-copy-monitors/",
    cells: ["No", "No", "No", "Match reports"],
  },
];

const isYes = (v: string) => v.startsWith("Yes");
---

<Base
  title="Protection techniques compared"
  description="Copy blockers, visible watermarks, Content Credentials, zero-width characters and copy monitors, compared with Kirpik on plain outcomes: what protects text after it leaves your store, and what proves ownership."
>
  <PageHero
    title="Protection techniques compared"
    lead="Apps in Shopify's anti-theft category rely on five techniques. This table compares them with Kirpik on the outcomes that matter: whether copying is stopped, whether the protection survives the text leaving your store, and whether ownership can be proved afterwards."
  />

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="tablewrap">
        <table class="ttable">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Technique</span></th>
              {COLUMNS.map((c) => <th scope="col">{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {ROWS.map((row) => (
              <tr class:list={[{ usrow: row.us }]}>
                <th scope="row">{row.href ? <a href={row.href}>{row.name}</a> : row.name}</th>
                {row.cells.map((cell) => <td class:list={[{ yes: isYes(cell) }]}>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tnote">
        Cells describe the typical, publicly documented behaviour of each technique class, not any
        single product. Each technique name links to its full comparison page. App-by-app comparisons,
        based on each app's own public Shopify App Store listing as recorded in June and July 2026, are
        in <a href="/compare/">the full survey</a>. App names and trademarks belong to their respective
        owners. Nothing here is legal advice.
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .tablewrap { overflow-x: auto; }
  .ttable { width: 100%; border-collapse: collapse; min-width: 760px; }
  .ttable th, .ttable td { padding: 0.95rem 1rem; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .ttable thead th { font-weight: 700; font-size: 0.95rem; color: var(--ink); text-align: center; }
  .ttable thead th:first-child { text-align: left; }
  .ttable tbody th { font-weight: 600; font-size: 0.98rem; color: var(--ink); text-align: left; }
  .ttable tbody th a { color: var(--orange-deep); }
  .ttable tbody th a:hover { color: var(--orange); }
  .ttable tbody tr:last-child th, .ttable tbody tr:last-child td { border-bottom: 0; }
  .ttable td { text-align: center; font-size: 0.98rem; color: var(--ink-faint); }
  .ttable td.yes { color: var(--ink); font-weight: 700; }
  .ttable .usrow th, .ttable .usrow td { background: var(--orange-tint); }
  .ttable .usrow td.yes { color: var(--orange-deep); }

  .tnote { margin-top: 1rem; font-size: 0.85rem; color: var(--ink-faint); line-height: 1.65; max-width: 78ch; }
  .tnote a { color: var(--orange-deep); font-weight: 600; }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>
