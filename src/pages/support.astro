---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";

const supportEmail = "support@kirpik.app";
---

<Base
  title="Support"
  description="Get help with Kirpik: browse the FAQ, see how protection and detection work, or email support@kirpik.app. Installed merchants can also use the in-app support form."
>
  <PageHero
    title="Support"
    lead="Most questions are answered in the FAQ and the how-it-works guide. For everything else, email support@kirpik.app."
  />

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="cards">
        <a class="card sc" href="/faq/" data-reveal>
          <h2>Browse the FAQ</h2>
          <p>The basics, the technology, day-to-day use, billing, and how proof turns into a takedown.</p>
          <span class="more">Open the FAQ →</span>
        </a>
        <a class="card sc" href="/how-it-works/" data-reveal>
          <h2>How Kirpik works</h2>
          <p>How protection, detection and Proof of Ownership Certificates work, step by step.</p>
          <span class="more">See the walkthrough →</span>
        </a>
        <a class="card sc" href={`mailto:${supportEmail}`} data-reveal>
          <h2>Email the team</h2>
          <p>Write to {supportEmail} with your store URL and what happened. We reply to every message.</p>
          <span class="more">Email {supportEmail} →</span>
        </a>
      </div>

      <div class="help" data-reveal>
        <h2>Already installed?</h2>
        <p>
          The fastest route is the app itself: open Kirpik in your Shopify
          admin and use the form on the Support page. It sends your store
          details along with your message. Include the item or URL involved
          and we can start from there.
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; margin-bottom: 1.4rem; }
  .sc {
    padding: 1.7rem; display: flex; flex-direction: column; gap: 0.5rem;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .sc:hover { transform: translateY(-3px); box-shadow: var(--shadow-pop); border-color: var(--orange); }
  .sc h2 { font-size: 1.25rem; }
  .sc p { color: var(--ink-soft); font-size: 0.97rem; }
  .more { margin-top: auto; padding-top: 0.7rem; font-weight: 700; font-size: 0.92rem; color: var(--orange-deep); }
  .help { margin-top: 1rem; }
  .help h2 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .help p { color: var(--ink-soft); max-width: 70ch; }
  @media (max-width: 880px) { .cards { grid-template-columns: 1fr; } }
</style>
