---
import Base from "../layouts/Base.astro";
import TextXray from "../components/TextXray.astro";
import SiteCheckForm from "../components/SiteCheckForm.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE } from "../config";
import { PLANS, MATRIX, FAQ_GROUPS } from "../data";

const faqTeaser = [
  FAQ_GROUPS[0].items[0],
  FAQ_GROUPS[0].items[1],
  FAQ_GROUPS[3].items[4],
  FAQ_GROUPS[1].items[1],
];

const SURVIVES = [
  "Copy and paste",
  "Automated scraping",
  "Bulk export",
  "Cutting and rewording",
  "Reformatting",
  "Reposting",
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: SITE.name,
    operatingSystem: "Web",
    applicationCategory: "BusinessApplication",
    description: SITE.description,
    url: SITE.url,
    offers: [
      { "@type": "Offer", name: "Free", price: "0", priceCurrency: "USD" },
      { "@type": "Offer", name: "Paid", price: "7.99", priceCurrency: "USD" },
      { "@type": "Offer", name: "Pro", price: "19.99", priceCurrency: "USD" },
    ],
    publisher: { "@id": `${SITE.url}/#organization` },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqTeaser.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base jsonLd={jsonLd}>
  <!-- ======================= Hero ======================= -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1 class="display">Protect your text. <em>Protect your brand.</em></h1>
        <p class="lead">
          Kirpik invisibly watermarks your product descriptions, articles and
          pages. If your content is stolen, Kirpik generates legal Proof of
          Ownership Certificates for DMCA takedowns and enforcement action.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href={SITE.shopifyAppUrl} rel="noopener" target="_blank">Install now for free</a>
          <a class="btn btn--ghost" href="/how-it-works/">How it works</a>
        </div>
      </div>
      <div class="hero__widget" data-reveal>
        <TextXray />
        <p class="hero__hint" aria-hidden="true">Drag the divider to reveal the watermark</p>
      </div>
    </div>
  </section>

  <!-- ======================= Site check band ======================= -->
  <SiteCheckForm
    tone="wide"
    heading="Is your store's content protected?"
    sub="Enter your Shopify store address and see exactly what a scraper sees, and whether your content is protected."
    cta="Check my store"
  />

  <!-- ======================= How it works ======================= -->
  <section class="section section--tone">
    <div class="container">
      <div class="narrow" style="text-align:center">
        <h2>Protect content. Prove infringement. Enforce your rights.</h2>
      </div>
      <div class="how__grid">
        <div class="card how__card" data-reveal>
          <span class="how__num">1</span>
          <h3>Protect your text</h3>
          <p>Pick products, articles and pages, then click Protect. Kirpik embeds your store's invisible watermark without changing a single word.</p>
        </div>
        <div class="card how__card" data-reveal>
          <span class="how__num">2</span>
          <h3>Prove content infringement</h3>
          <p>Paste suspect text or check a URL. Kirpik detects your watermark and reports the match with a confidence figure.</p>
          <div class="how__mock hud" aria-hidden="true">
            <span>&gt; checking onlinedirect-example.biz</span><br />
            <span class="ok">✓ watermark detected</span><br />
            <span>owner <b>your-store.myshopify.com</b> · confidence <b>100.0%</b></span>
          </div>
        </div>
        <div class="card how__card" data-reveal>
          <span class="how__num">3</span>
          <h3>Enforce your rights, takedown infringing IP</h3>
          <p>Generate a Proof of Ownership Certificate, dated and independently verifiable. Send it with a DMCA notice to the thief's host or marketplace; the <a href="/enforcement/">enforcement guide</a> walks you through it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= Nothing changes ======================= -->
  <section class="section">
    <div class="container">
      <div class="narrow" style="text-align:center">
        <h2>Nothing changes for you or your customers.</h2>
      </div>
      <div class="nc__grid">
        <div class="nc__col" data-reveal>
          <h3>Your text is not modified</h3>
          <p>Every word, heading and comma stays exactly as you wrote it. Readers see your copy, unchanged.</p>
        </div>
        <div class="nc__col" data-reveal>
          <h3>No SEO impact</h3>
          <p>Search engines read the same copy your customers do. There is nothing added for a crawler to penalise.</p>
        </div>
        <div class="nc__col" data-reveal>
          <h3>No speed impact</h3>
          <p>Kirpik adds nothing to your theme. Your page speed and checkout are untouched.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= Resilience ======================= -->
  <section class="section section--ink">
    <div class="container resilience__grid">
      <div>
        <h2>Kirpik's watermark algorithm is resilient:</h2>
        <p class="lead" style="margin-top:1rem">
          The watermark lives in the text itself, not in the page around it.
          Wherever your copy is taken - even if it is modified or resaved - the
          watermark identifying the content as yours remains embedded.
        </p>
      </div>
      <ul class="resilience__list" aria-label="What the watermark survives">
        {SURVIVES.map((a) => (
          <li data-reveal>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {a}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ======================= Enforcement ======================= -->
  <section class="section section--tone">
    <div class="container cop__grid">
      <div class="cop__img" data-reveal>
        <img src="/img/chain-of-proof-top.png" alt="A Kirpik Proof of Ownership Certificate" width="620" height="404" loading="lazy" />
      </div>
      <div>
        <h2>Prove infringement and enforce your rights.</h2>
        <p class="lead" style="margin:1rem 0 1.4rem">
          When Kirpik detects your watermark on someone else's page, you can
          issue a Proof of Ownership Certificate. Hosts, marketplaces and
          search engines act on proof, and this certificate supplies it.
        </p>
        <ul class="cop__list">
          <li>A record of your exact original text and of the stolen copy</li>
          <li>Your protection date versus the infringing page's timestamps</li>
          <li>Independent timeline evidence from the Internet Archive</li>
          <li>Watermark match details and a confidence figure</li>
          <li>A public verification page anyone can check via QR code</li>
        </ul>
        <a class="btn btn--ghost" href="/enforcement/" style="margin-top:1.6rem">How enforcement works</a>
      </div>
    </div>
  </section>

  <!-- ======================= Pricing ======================= -->
  <section class="section" id="pricing">
    <div class="container">
      <div class="narrow" style="text-align:center">
        <h2>Start free.</h2>
      </div>

      <div class="plans">
        {PLANS.map((p) => (
          <div class:list={["card", "plan", { "plan--featured": p.featured }]} data-reveal>
            {p.featured && <span class="plan__flag">Recommended</span>}
            <h3>{p.name}</h3>
            <p class="plan__price">{p.price}<span> {p.per}</span></p>
            <p class="plan__blurb">{p.blurb}</p>
            <ul class="plan__feats">
              {p.feats.map((f) => (
                <li>
                  <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <a class:list={["btn", p.featured ? "btn--primary" : "btn--ghost", "plan__cta"]} href={SITE.shopifyAppUrl} rel="noopener" target="_blank">{p.cta}</a>
          </div>
        ))}
      </div>

      <div class="matrix card" data-reveal>
        <table>
          <thead>
            <tr><th scope="col">Feature</th><th scope="col">Free</th><th scope="col">Paid</th><th scope="col">Pro</th></tr>
          </thead>
          <tbody>
            {MATRIX.map(([label, a, b, c]) => (
              <tr>
                <th scope="row">{label}</th>
                {[a, b, c].map((v) => (
                  <td>
                    {v === true ? <span class="matrix__yes">✓</span> : v === false ? <span class="matrix__no">✕</span> : v}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ======================= FAQ ======================= -->
  <section class="section section--tone">
    <div class="container narrow">
      <h2 style="margin-bottom:1.8rem">Common questions</h2>
      {faqTeaser.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
      <p style="margin-top:1.6rem"><a class="btn btn--ghost" href="/faq/">See the full FAQ</a></p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(2.6rem, 2rem + 3.5vw, 5.5rem) clamp(2.6rem, 4vw, 4.5rem); }
  .hero__grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(2rem, 4.5vw, 4rem); align-items: center; }
  .display { font-size: var(--fs-display); }
  .hero__copy .lead { margin: 1.4rem 0 1.9rem; max-width: 56ch; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .hero__hint { margin-top: 0.8rem; text-align: center; font-size: 0.88rem; color: var(--ink-soft); }
  @media (max-width: 960px) { .hero__grid { grid-template-columns: 1fr; } }

  /* How it works */
  .how__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; margin-top: 2.6rem; }
  .how__card { padding: 1.6rem; display: flex; flex-direction: column; }
  .how__num {
    font-family: var(--font-mono); font-weight: 600; font-size: 0.85rem;
    width: 2em; height: 2em; display: grid; place-items: center;
    border-radius: 50%; background: var(--orange-tint); color: var(--orange-deep);
    margin-bottom: 1rem;
  }
  .how__card h3 { margin-bottom: 0.55rem; }
  .how__card p { color: var(--ink-soft); font-size: 0.98rem; }
  .how__card p a { color: var(--orange-deep); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .how__mock.hud { margin-top: 1.2rem; }
  @media (max-width: 880px) { .how__grid { grid-template-columns: 1fr; } }

  /* Nothing changes */
  .nc__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 4vw, 3rem); margin-top: 2.6rem; }
  .nc__col h3 { margin-bottom: 0.6rem; }
  .nc__col p { color: var(--ink-soft); font-size: 0.98rem; }
  @media (max-width: 880px) { .nc__grid { grid-template-columns: 1fr; } }

  /* Resilience */
  .resilience__grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .resilience__list { display: grid; gap: 0.9rem; }
  .resilience__list li {
    display: flex; align-items: center; gap: 0.7em;
    font-size: 1.05rem; font-weight: 600; color: var(--sand);
    border-bottom: 1px solid rgba(233,229,220,0.12);
    padding-bottom: 0.9rem;
  }
  .resilience__list li:last-child { border-bottom: 0; padding-bottom: 0; }
  .resilience__list svg { color: var(--mint); flex: none; }
  @media (max-width: 880px) { .resilience__grid { grid-template-columns: 1fr; } }

  /* Enforcement */
  .cop__grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .cop__img img { border-radius: var(--r-md); box-shadow: var(--shadow-pop); border: 1px solid var(--line); }
  .cop__list { display: grid; gap: 0.6rem; }
  .cop__list li { position: relative; padding-left: 1.6rem; color: var(--ink-soft); }
  .cop__list li::before {
    content: ""; position: absolute; left: 0.1rem; top: 0.55em;
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--orange); box-shadow: 0 0 0 3px rgba(217,100,56,0.16);
  }
  @media (max-width: 880px) { .cop__grid { grid-template-columns: 1fr; } .cop__img { max-width: 420px; margin-inline: auto; } }

  /* Pricing */
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; margin-top: 2.6rem; align-items: start; }
  .plan { padding: 1.8rem; position: relative; display: flex; flex-direction: column; }
  .plan--featured { border-color: var(--orange); box-shadow: 0 0 0 1px var(--orange), var(--shadow-pop); }
  .plan__flag {
    position: absolute; top: -0.85em; left: 1.4rem;
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    background: var(--orange); color: #fff; padding: 0.35em 0.75em; border-radius: var(--r-pill);
  }
  .plan__price { font-size: 2.3rem; font-weight: 800; letter-spacing: -0.03em; margin: 0.5rem 0 0.2rem; }
  .plan__price span { font-size: 0.95rem; font-weight: 600; color: var(--ink-faint); letter-spacing: 0; }
  .plan__blurb { color: var(--ink-soft); font-size: 0.95rem; margin-bottom: 1.1rem; }
  .plan__feats { display: grid; gap: 0.5rem; margin-bottom: 1.6rem; }
  .plan__feats li { display: flex; align-items: baseline; gap: 0.55em; font-size: 0.95rem; color: var(--ink-soft); }
  .plan__feats svg { color: var(--mint); flex: none; }
  .plan__cta { justify-content: center; margin-top: auto; }
  @media (max-width: 880px) { .plans { grid-template-columns: 1fr; } }

  .matrix { margin-top: 2rem; overflow-x: auto; padding: 0.4rem 1.2rem 1rem; }
  .matrix table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .matrix th, .matrix td { text-align: left; padding: 0.7rem 0.8rem; border-bottom: 1px solid var(--line); }
  .matrix thead th { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); }
  .matrix tbody th { font-weight: 600; color: var(--ink); }
  .matrix td { color: var(--ink-soft); }
  .matrix__yes { color: var(--mint); font-weight: 700; }
  .matrix__no { color: var(--ink-faint); }

  /* FAQ */
  .faq { border-top: 1px solid var(--line); }
  .faq:last-of-type { border-bottom: 1px solid var(--line); }
  .faq summary {
    cursor: pointer; list-style: none; position: relative;
    font-weight: 700; padding: 1.05rem 2.2rem 1.05rem 0;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: "+"; position: absolute; right: 0.2rem; top: 50%; transform: translateY(-50%);
    font-weight: 400; font-size: 1.4rem; color: var(--orange-deep);
    transition: transform 0.18s ease;
  }
  .faq[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .faq p { padding: 0 0 1.2rem; color: var(--ink-soft); max-width: 65ch; }
</style>
