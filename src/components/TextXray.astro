---
/**
 * Signature element: drag to see the invisible watermark inside product text.
 * The right-hand pane shows a stylised detector view with glowing markers and
 * a short detection readout. Marker positions are illustrative set dressing
 * for the demo, not a readout of anything real. Keyboard-accessible via the
 * range input.
 */
interface Props {
  domain?: string;
  start?: number; // initial reveal %
}
const { domain = "demo-store.myshopify.com", start = 55 } = Astro.props;

// The demo product text. Markers (glowing highlights in the detector pane)
// are placed on arbitrary letters purely for the visual.
const TITLE = "Juniper & Cedar Soy Candle";
const COPY = [
  "Hand-poured in small batches, Juniper & Cedar opens with crushed juniper berry over dry cedarwood, finished with a trace of smoked vanilla. Like a walk through a cold pine forest after rain.",
  "The 220g natural soy blend burns clean for around 45 hours in a reusable amber glass jar, with a lead-free cotton wick and no synthetic dyes. Cured and boxed by hand in our Yorkshire workshop.",
];

/** Wrap arbitrary characters in marker spans for the detector pane. */
function markup(text: string, seed: number): string {
  const words = text.split(" ");
  return words
    .map((w, i) => {
      // Roughly every 3rd word gets one glowing character. Deterministic so
      // the two panes and every build render identically.
      if ((i + seed) % 3 === 1 && w.length > 3) {
        const at = (i * 7 + seed) % (w.length - 2) + 1;
        return (
          w.slice(0, at) +
          `<span class="txm">${w[at]}</span>` +
          w.slice(at + 1)
        );
      }
      return w;
    })
    .join(" ");
}
const marked = COPY.map((p, i) => markup(p, i * 3 + 1));
---

<figure class="xray" data-reveal-widget style={`--pos:${start}%`}>
  <!-- plain pane: what everyone sees -->
  <div class="xray__page">
    <p class="xray__title">{TITLE}</p>
    <p class="xray__price" aria-hidden="true">£24.00</p>
    {COPY.map((p) => <p class="xray__copy">{p}</p>)}
  </div>

  <!-- detector pane: what Kirpik sees -->
  <div class="xray__over" aria-hidden="true">
    <div class="xray__page xray__page--dark">
      <p class="xray__title">{TITLE}</p>
      <p class="xray__price">£24.00</p>
      {marked.map((p) => <p class="xray__copy" set:html={p} />)}
    </div>

    <div class="xray__hud">
      <span class="xray__detected">
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M2 8.5 6 12l8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        WATERMARK DETECTED
      </span>
      <span class="xray__owner">{domain}</span>
    </div>
  </div>

  <span class="xray__tag xray__tag--left" aria-hidden="true">What everyone sees</span>
  <span class="xray__tag xray__tag--right" aria-hidden="true">What Kirpik sees</span>

  <div class="xray__divider" aria-hidden="true">
    <span class="xray__handle">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6 4 12l5 6M15 6l5 6-5 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </div>

  <input class="xray__range" type="range" min="0" max="100" value={start}
    aria-label="Drag to reveal the hidden watermark" />
</figure>

<style>
  .xray {
    position: relative; margin: 0;
    border-radius: var(--r-lg); overflow: hidden;
    box-shadow: var(--shadow-pop);
    background: var(--surface);
    border: 1px solid var(--line);
    isolation: isolate;
    user-select: none; touch-action: pan-y;
    min-height: 400px;
  }

  .xray__page {
    position: absolute; inset: 0;
    padding: 3rem clamp(1.2rem, 3vw, 2rem) 5.5rem;
    overflow: hidden;
  }
  .xray__title { font-weight: 800; font-size: clamp(1.15rem, 2.4vw, 1.5rem); letter-spacing: -0.015em; margin-bottom: 0.15rem; }
  .xray__price { font-family: var(--font-mono); font-size: 0.85rem; color: var(--ink-soft); margin-bottom: 1rem; }
  .xray__copy { font-size: 0.92rem; line-height: 1.66; color: var(--ink-soft); margin-bottom: 0.8rem; max-width: 60ch; }

  /* detector pane */
  .xray__over { position: absolute; inset: 0; clip-path: inset(0 0 0 var(--pos)); background: var(--ink); }
  .xray__page--dark { background: var(--ink); }
  .xray__page--dark .xray__title { color: #eceef6; }
  .xray__page--dark .xray__price { color: #9298b3; }
  .xray__page--dark .xray__copy { color: #a7acc4; }

  .xray__page--dark :global(.txm) {
    color: var(--amber);
    text-shadow: 0 0 10px rgba(221, 159, 74, 0.85);
    border-bottom: 2px dotted rgba(221, 159, 74, 0.7);
    animation: txm-pulse 2.6s ease-in-out infinite;
  }
  @keyframes txm-pulse {
    0%, 100% { text-shadow: 0 0 6px rgba(221, 159, 74, 0.55); }
    50% { text-shadow: 0 0 13px rgba(221, 159, 74, 1); }
  }
  @media (prefers-reduced-motion: reduce) { .xray__page--dark :global(.txm) { animation: none; } }

  /* Detection readout: anchored inside the revealed region so the divider
     never clips it. */
  .xray__hud {
    position: absolute; left: calc(var(--pos) + 12px); right: 12px; bottom: 12px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 0.3rem 1rem;
    background: rgba(14, 17, 31, 0.85);
    border: 1px solid rgba(233,229,220,0.14);
    border-radius: 10px; padding: 0.6rem 0.85rem;
    overflow: hidden;
  }
  .xray__detected {
    display: inline-flex; align-items: center; gap: 0.45em;
    font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.07em; color: var(--amber);
    white-space: nowrap;
  }
  .xray__detected svg { color: var(--mint); flex: none; }
  .xray__owner { font-family: var(--font-mono); font-size: 0.72rem; color: #fff; overflow-wrap: anywhere; }

  .xray__tag {
    position: absolute; top: 12px; z-index: 3;
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600;
    letter-spacing: 0.07em; text-transform: uppercase;
    padding: 0.4em 0.7em; border-radius: var(--r-pill);
  }
  .xray__tag--left { left: 12px; background: var(--paper-2); color: var(--ink); border: 1px solid var(--line); }
  .xray__tag--right { right: 12px; background: var(--orange); color: #fff; opacity: 0; transition: opacity 0.2s; }
  .xray[data-revealed] .xray__tag--right { opacity: 1; }

  .xray__divider { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; background: rgba(24,28,47,0.85); box-shadow: 0 0 0 1px rgba(255,255,255,0.25); z-index: 4; }
  .xray__handle {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    width: 42px; height: 42px; border-radius: 50%;
    background: #fff; color: var(--orange-deep);
    display: grid; place-items: center;
    box-shadow: 0 6px 18px -6px rgba(0,0,0,0.45);
  }

  .xray__range {
    -webkit-appearance: none; appearance: none;
    position: absolute; inset: 0; width: 100%; height: 100%;
    margin: 0; background: transparent; z-index: 5; cursor: ew-resize;
  }
  .xray__range::-webkit-slider-thumb { -webkit-appearance: none; width: 44px; height: 100%; background: transparent; }
  .xray__range::-moz-range-thumb { width: 44px; height: 100%; background: transparent; border: 0; }
  .xray__range:focus-visible { box-shadow: none; }
  .xray__range:focus-visible ~ .xray__divider .xray__handle { box-shadow: var(--ring), 0 6px 18px -6px rgba(0,0,0,0.45); }
</style>

<script>
  function initXray(fig: HTMLElement) {
    const range = fig.querySelector<HTMLInputElement>(".xray__range");
    if (!range) return;
    const set = (v: number) => {
      const clamped = Math.max(0, Math.min(100, v));
      fig.style.setProperty("--pos", clamped + "%");
      fig.toggleAttribute("data-revealed", clamped < 78);
    };
    range.addEventListener("input", () => set(Number(range.value)));
    set(Number(range.value));
  }
  document.querySelectorAll<HTMLElement>("[data-reveal-widget]").forEach(initXray);
</script>
